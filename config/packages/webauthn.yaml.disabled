webauthn:
    credential_repository: App\Repository\PublicKeyCredentialSourceRepository
    
    creation_profiles:
        default:
            rp:
                name: 'AgriPlatform'
                id: 'localhost'
            challenge_length: 32
            timeout: 60000
            authenticator_selection_criteria:
                authenticator_attachment: 'platform'
                user_verification: 'required'
                resident_key: 'required'
            attestation_conveyance: 'none'
            
    request_profiles:
        default:
            rp_id: 'localhost'
            challenge_length: 32
            timeout: 60000
            user_verification: 'required'
