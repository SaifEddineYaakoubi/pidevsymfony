{# Partial returned for AJAX: stats + table #}

<div class="crud-header">
    {% set total = stats.total_filtered ?? archives|length %}
    {% set sumQte = stats.sum_quantite ?? 0 %}
    {% set lastArch = stats.last_archivage ?? null %}
    {% set top = stats.top_causes ?? [] %}
    {% set others = stats.others_count ?? 0 %}

    <div class="agri-stats-top mb-2">
        <div class="agri-stats-title">Statistiques des archives</div>
        <div class="agri-stats-title">Top causes de suppression</div>
    </div>


    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% for i in 0..2 %}
            {% set c = top[i] ?? null %}
            {% if c %}
                {% set percent = (total > 0 ? ((c.count / total) * 100) : 0) %}
                <div class="agri-progress__seg agri-progress__seg--cause{{ i+1 }}" style="width: {{ percent }}%"></div>
            {% endif %}
        {% endfor %}
        {% if others > 0 %}
            {% set percent = (total > 0 ? ((others / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--autres" style="width: {{ percent }}%"></div>
        {% endif %}
    </div>

    <div class="agri-stats-badges justify-content-end mt-2">
        {% for i in 0..2 %}
            {% set c = top[i] ?? null %}
            {% if c %}
                <span class="badge text-bg-secondary">{{ c.cause }}: {{ c.count }}</span>
            {% endif %}
        {% endfor %}
        {% if others > 0 %}
            <span class="badge text-bg-dark">Autres: {{ others }}</span>
        {% endif %}
    </div>
</div>

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted small">
            {{ archives|length }} résultat(s){% if q %} pour "{{ q }}"{% endif %}
        </div>
    </div>

    <div class="row g-3" id="archiveCards">
        {% for archive in archives %}
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="card h-100 agri-card"
                     role="button"
                     data-card-type="archive"
                     data-id="{{ archive.id_archive }}"
                     data-href="{{ path('app_archive_show', {'idArchive': archive.id_archive}) }}"
                     style="cursor: pointer; transition: all 0.2s ease; background: linear-gradient(135deg, rgba(34, 139, 34, 0.12), rgba(50, 205, 50, 0.10)) !important;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title text-truncate mb-1">{{ archive.type_culture }}</h5>
                            <span class="badge bg-warning fs-6">
                                <i class="fas fa-archive me-1"></i>Archivée
                            </span>
                        </div>

                        <div class="mb-2">
                            <strong class="text-success">{{ archive.quantite }} kg</strong>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                {{ archive.localisation }}
                            </small>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="fas fa-calendar-times me-1"></i>
                                Archivée le {{ archive.date_archivage ? archive.date_archivage|date('d/m/Y') : '-' }}
                            </small>
                        </div>

                        <div class="mb-2">
                            <small class="text-warning">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                Cause: {{ archive.cause_supression ?: 'Non spécifiée' }}
                            </small>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary flex-fill" href="{{ path('app_archive_show', {'idArchive': archive.id_archive}) }}">Voir</a>
                            <button class="btn btn-sm btn-outline-secondary flex-fill" disabled title="Les archives ne peuvent pas être modifiées">Modifier</button>
                            <button class="btn btn-sm btn-outline-danger flex-fill" disabled title="Les archives ne peuvent pas être supprimées">Supprimer</button>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center text-muted py-5">
                    <i class="fas fa-archive fa-3x mb-3"></i>
                    <p>Aucune archive trouvée</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

