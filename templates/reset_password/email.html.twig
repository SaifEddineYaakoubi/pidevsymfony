{# templates/reset_password/email.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation SmartFarm</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background: #ffffff;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .email-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 30px;
            text-align: center;
            color: white;
        }
        .email-header h1 {
            margin: 0;
            font-size: 24px;
        }
        .email-header p {
            margin: 10px 0 0;
            opacity: 0.9;
        }
        .email-body {
            padding: 30px;
            background: white;
            color: #333;
        }
        .email-button {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white !important;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 25px;
            margin: 20px 0;
            font-weight: bold;
        }
        .email-footer {
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #6c757d;
            background: #f8f9fa;
        }
        .warning {
            color: #e74c3c;
            font-size: 12px;
            margin-top: 15px;
            padding: 10px;
            background: #fdeaea;
            border-radius: 8px;
        }
        .link-box {
            background: #f0f0f0;
            padding: 10px;
            border-radius: 5px;
            word-break: break-all;
            font-size: 12px;
            font-family: monospace;
        }
        a {
            color: #667eea;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>🔐 SmartFarm</h1>
            <p>Réinitialisation du mot de passe</p>
        </div>

        <div class="email-body">
            <p>Bonjour,</p>

            <p>Nous avons reçu une demande de réinitialisation de votre mot de passe pour votre compte SmartFarm.</p>

            <p>Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe :</p>

            <div style="text-align: center;">
                <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" class="email-button">
                    🔐 Réinitialiser mon mot de passe
                </a>
            </div>

            <p style="margin-top: 20px;">Ou copiez ce lien dans votre navigateur :</p>
            <div class="link-box">
                {{ url('app_reset_password', {token: resetToken.token}) }}
            </div>

            <div class="warning">
                ⚠️ Ce lien expirera dans <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
                Si vous n'avez pas demandé cette réinitialisation, ignorez cet email.
            </div>
        </div>

        <div class="email-footer">
            <p>© {{ "now"|date("Y") }} SmartFarm - Système de Gestion Agricole</p>
            <p>Cet email a été envoyé automatiquement, merci de ne pas y répondre.</p>
        </div>
    </div>
</body>
</html>