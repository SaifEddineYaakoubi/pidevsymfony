<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a href="{{ path('app_admin_dashboard') }}" class="brand-link">
        <img src="{{ asset('adminlte/dist/img/AdminLTELogo.png') }}" alt="Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
        <span class="brand-text font-weight-light">SmartFarm</span>
    </a>

    <div class="sidebar">
        <!-- AFFICHAGE UTILISATEUR SIMPLE -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <img src="{{ asset('adminlte/dist/img/user2-160x160.jpg') }}" class="img-circle elevation-2" alt="User Image">
            </div>
            <div class="info">
                <a href="#" class="d-block">{{ app.user ? app.user.userIdentifier : 'Invité' }}</a>
                <small>
                    {% if app.user %}
                        {% set roles = app.user.roles %}
                        {% if 'ROLE_ADMIN' in roles %}
                            <span class="badge bg-danger">Administrateur</span>
                        {% elseif 'ROLE_STOCK' in roles %}
                            <span class="badge bg-warning">Responsable Stock</span>
                        {% elseif 'ROLE_AGRICULTEUR' in roles %}
                            <span class="badge bg-success">Agriculteur</span>
                        {% endif %}
                    {% endif %}
                </small>
            </div>
        </div>

        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                <li class="nav-header">GESTION</li>

                <li class="nav-item">
                    <a href="{{ path('app_admin_utilisateur_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_utilisateur_' ? 'active' : '' }}">
                        <i class="nav-icon fas fa-users"></i>
                        <p>Gestion Utilisateurs</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_admin_parcelles') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_parcelles' ? 'active' : '' }}">
                        <i class="nav-icon fas fa-map-marked-alt"></i>
                        <p>Parcelles</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_admin_cultures') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_cultures' ? 'active' : '' }}">
                        <i class="nav-icon fas fa-seedling"></i>
                        <p>Cultures</p>
                    </a>
                </li>
            {# Gestion vente #}
            <li class="nav-item">
                <a href="{{ path('app_admin_vente_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_vente' ? 'active' : '' }}">
                    <i class="nav-icon fas fa-shopping-basket"></i>
                    <p>Ventes</p>
                </a>
            </li>

            <li class="nav-item">
                <a href="{{ path('app_admin_client_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_client' ? 'active' : '' }}">
                    <i class="nav-icon fas fa-users"></i>
                    <p>Clients</p>
                </a>
            </li>
                <!-- SECTION COMPTE -->
                <li class="nav-header">COMPTE</li>

                <li class="nav-item has-treeview">
                    <a href="#" class="nav-link">
                        <i class="nav-icon fas fa-user-circle"></i>
                        <p>
                            Mon Compte
                            <i class="right fas fa-angle-left"></i>
                        </p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="#" class="nav-link" data-toggle="modal" data-target="#profileModal">
                                <i class="far fa-circle nav-icon"></i>
                                <p>Mon Profil</p>
                            </a>
                        </li>
                        <!-- Option "Changer mot de passe" commentée pour l'instant -->
                        {# <li class="nav-item">
                            <a href="#" class="nav-link" onclick="event.preventDefault(); changePassword();">
                                <i class="far fa-circle nav-icon"></i>
                                <p>Changer mot de passe</p>
                            </a>
                        </li> #}
                        <li class="nav-item">
                            <a href="/admin/logout" class="nav-link text-danger"
                               onclick="event.preventDefault(); confirmLogout();">
                                <i class="far fa-circle nav-icon"></i>
                                <p>Déconnexion</p>
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
</aside>

<!-- Modal Profil -->
<div class="modal fade" id="profileModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-user-circle"></i> Mon Profil
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img src="{{ asset('adminlte/dist/img/user2-160x160.jpg') }}"
                         class="img-circle elevation-2"
                         style="width: 100px; height: 100px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr>
                        <th><i class="fas fa-user"></i> Nom complet :</th>
                        <td>{{ app.user.nom }} {{ app.user.prenom }}</td>
                    </tr>
                    <tr>
                        <th><i class="fas fa-envelope"></i> Email :</th>
                        <td>{{ app.user.email }}</td>
                    </tr>
                    <tr>
                        <th><i class="fas fa-tag"></i> Rôle :</th>
                        <td>
                            {% set roles = app.user.roles %}
                            {% if 'ROLE_ADMIN' in roles %}
                                <span class="badge bg-danger">Administrateur</span>
                            {% elseif 'ROLE_STOCK' in roles %}
                                <span class="badge bg-warning">Responsable Stock</span>
                            {% elseif 'ROLE_AGRICULTEUR' in roles %}
                                <span class="badge bg-success">Agriculteur</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th><i class="fas fa-calendar"></i> Date création :</th>
                        <td>{{ app.user.dateCreation ? app.user.dateCreation|date('d/m/Y') : 'N/A' }}</td>
                    </tr>
                    <tr>
                        <th><i class="fas fa-power-off"></i> Statut :</th>
                        <td>
                            {% if app.user.statut %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger">Inactif</span>
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times"></i> Fermer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function confirmLogout() {
    Swal.fire({
        title: 'Déconnexion',
        text: 'Êtes-vous sûr de vouloir vous déconnecter ?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Oui, me déconnecter',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = "/admin/logout";
        }
    });
}

