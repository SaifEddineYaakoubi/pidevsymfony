{% extends 'admin/base_admin.html.twig' %}

{% block admin_page_title %}Gestion des Ventes{% endblock %}

{% block admin_body %}
<div class="row">
    <div class="col-12">
        {# Stats Cards #}
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="small-box bg-info shadow">
                    <div class="inner">
                        <h3>{{ (stats.total_revenus ?? 0)|number_format(2, '.', ' ') }} <small>DT</small></h3>
                        <p>Total Revenus</p>
                    </div>
                    <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-success shadow">
                    <div class="inner">
                        <h3>{{ stats.ventes_count ?? 0 }}</h3>
                        <p>Nombre de Ventes</p>
                    </div>
                    <div class="icon"><i class="fas fa-shopping-cart"></i></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="small-box bg-warning shadow">
                    <div class="inner">
                        <h3>{{ (stats.montant_moyen ?? 0)|number_format(2, '.', ' ') }} <small>DT</small></h3>
                        <p>Montant Moyen</p>
                    </div>
                    <div class="icon"><i class="fas fa-chart-pie"></i></div>
                </div>
            </div>
        </div>

        {# Table Card #}
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title">Liste des Ventes</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-sm btn-info mr-2"
                            data-toggle="modal" data-target="#statsModal">
                        <i class="fas fa-chart-bar"></i> Statistiques
                    </button>
                    <a href="{{ path('app_admin_vente_new') }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus"></i> Ajouter
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover m-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Produit</th>
                            <th>Quantité</th>
                            <th>Total</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for vente in ventes %}
                            <tr>
                                <td>{{ vente.dateVente|date('d/m/Y') }}</td>
                                <td><span class="badge badge-info">{{ vente.idClient ? vente.idClient.nom : 'N/A' }}</span></td>
                                <td>{{ vente.idProduit ? vente.idProduit.nom : 'N/A' }}</td>
                                <td>{{ vente.quantite }}</td>
                                <td class="font-weight-bold">{{ vente.montantTotal|number_format(2, '.', ' ') }} DT</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="{{ path('app_admin_vente_edit', {idVente: vente.idVente}) }}" class="btn btn-xs btn-warning mr-1">
                                            <i class="fas fa-edit text-white"></i>
                                        </a>
                                        <button class="btn btn-xs btn-danger delete-btn"
                                                data-toggle="modal"
                                                data-target="#deleteModal"
                                                data-id="{{ vente.idVente }}"
                                                data-token="{{ csrf_token('delete' ~ vente.idVente) }}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center py-4">Aucune vente trouvée.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Modal Statistiques #}
<div class="modal fade" id="statsModal" tabindex="-1" role="dialog" aria-labelledby="statsModalLabel">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="statsModalLabel">
                    <i class="fas fa-chart-line mr-2"></i> Statistiques de Vente
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">

                {# KPI Cards #}
                <div class="row mb-3">
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>{{ stats_globales.total_ventes }}</h3>
                                <p>Total Ventes</p>
                            </div>
                            <div class="icon"><i class="fas fa-shopping-cart"></i></div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>{{ stats_globales.total_revenus|number_format(0, '.', ' ') }} <small>DT</small></h3>
                                <p>Revenus Totaux</p>
                            </div>
                            <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>{{ stats_globales.total_clients }}</h3>
                                <p>Clients Actifs</p>
                            </div>
                            <div class="icon"><i class="fas fa-users"></i></div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>{{ stats_globales.montant_moyen|number_format(2, '.', ' ') }} <small>DT</small></h3>
                                <p>Panier Moyen</p>
                            </div>
                            <div class="icon"><i class="fas fa-chart-line"></i></div>
                        </div>
                    </div>
                </div>

                {# Taux de croissance + Prédiction #}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card card-outline card-primary mb-0">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-chart-line mr-1"></i> Taux de Croissance</h3>
                            </div>
                            <div class="card-body text-center">
                                <h1 class="display-4 {{ taux_croissance >= 0 ? 'text-success' : 'text-danger' }}">
                                    {{ taux_croissance >= 0 ? '+' : '' }}{{ taux_croissance|number_format(1) }}%
                                </h1>
                                <p class="text-muted">Mois actuel vs mois précédent</p>
                                {% if comparaison.mois_actuel is defined and comparaison.mois_precedent is defined %}
                                <div class="row mt-3">
                                    <div class="col-6">
                                        <h6>Mois Actuel</h6>
                                        <p class="mb-0"><strong>{{ comparaison.mois_actuel.nombre_ventes }}</strong> ventes</p>
                                        <p><strong>{{ comparaison.mois_actuel.total_revenus|number_format(2) }}</strong> DT</p>
                                    </div>
                                    <div class="col-6">
                                        <h6>Mois Précédent</h6>
                                        <p class="mb-0"><strong>{{ comparaison.mois_precedent.nombre_ventes }}</strong> ventes</p>
                                        <p><strong>{{ comparaison.mois_precedent.total_revenus|number_format(2) }}</strong> DT</p>
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-outline card-primary mb-0">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-magic mr-1"></i> Prédiction Mois Prochain</h3>
                            </div>
                            <div class="card-body text-center">
                                <h1 class="display-4 text-primary">{{ prediction|number_format(0, '.', ' ') }} <small>DT</small></h1>
                                <p class="text-muted">Basée sur la moyenne des 3 derniers mois</p>
                                <div class="progress mt-3" style="height: 25px;">
                                    <div class="progress-bar bg-primary" style="width: 100%">Revenus Estimés</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Graphique #}
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="card card-outline card-info mb-0">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-chart-area mr-1"></i> Évolution des Ventes (12 derniers mois)</h3>
                            </div>
                            <div class="card-body">
                                <canvas id="statsVentesChart" height="80"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                {# Top Produits + Top Clients #}
                <div class="row">
                    <div class="col-md-6">
                        <div class="card card-outline card-warning mb-0">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-trophy mr-1"></i> Top 5 Produits</h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-striped mb-0">
                                    <thead><tr><th>#</th><th>Produit</th><th>Ventes</th><th>Revenus</th></tr></thead>
                                    <tbody>
                                        {% for index, produit in top_produits %}
                                        <tr>
                                            <td>
                                                {% if index == 0 %}<i class="fas fa-medal text-warning"></i>
                                                {% elseif index == 1 %}<i class="fas fa-medal text-secondary"></i>
                                                {% elseif index == 2 %}<i class="fas fa-medal text-danger"></i>
                                                {% else %}{{ index + 1 }}{% endif %}
                                            </td>
                                            <td><strong>{{ produit.produit }}</strong></td>
                                            <td><span class="badge badge-info">{{ produit.nombre_ventes }}</span></td>
                                            <td><span class="badge badge-success">{{ produit.revenus_totaux|number_format(2) }} DT</span></td>
                                        </tr>
                                        {% else %}
                                        <tr><td colspan="4" class="text-center">Aucune donnée</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-outline card-success mb-0">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-star mr-1"></i> Top 5 Clients</h3>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-striped mb-0">
                                    <thead><tr><th>#</th><th>Client</th><th>Achats</th><th>Total</th></tr></thead>
                                    <tbody>
                                        {% for index, client in top_clients %}
                                        <tr>
                                            <td>
                                                {% if index == 0 %}<i class="fas fa-medal text-warning"></i>
                                                {% elseif index == 1 %}<i class="fas fa-medal text-secondary"></i>
                                                {% elseif index == 2 %}<i class="fas fa-medal text-danger"></i>
                                                {% else %}{{ index + 1 }}{% endif %}
                                            </td>
                                            <td><strong>{{ client.client }}</strong></td>
                                            <td><span class="badge badge-info">{{ client.nombre_achats }}</span></td>
                                            <td><span class="badge badge-success">{{ client.total_depense|number_format(2) }} DT</span></td>
                                        </tr>
                                        {% else %}
                                        <tr><td colspan="4" class="text-center">Aucune donnée</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Fermer
                </button>
            </div>
        </div>
    </div>
</div>

{# Modal Delete #}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" method="POST">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Supprimer</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">Voulez-vous supprimer cette vente ?<input type="hidden" name="_token" id="deleteToken"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Confirmer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        $('.delete-btn').on('click', function() {
            const id = $(this).data('id');
            const token = $(this).data('token');
            const action = "{{ path('app_admin_vente_delete', {'idVente': 'ID'}) }}".replace('ID', id);
            $('#deleteForm').attr('action', action);
            $('#deleteToken').val(token);
        });

        // Initialiser le graphique quand le modal s'ouvre
        $('#statsModal').on('shown.bs.modal', function () {
            if (window.statsChartInstance) {
                window.statsChartInstance.destroy();
            }
            const ctx = document.getElementById('statsVentesChart').getContext('2d');
            window.statsChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: {{ mois_labels|raw }},
                    datasets: [
                        {
                            label: 'Nombre de Ventes',
                            data: {{ mois_ventes|raw }},
                            borderColor: 'rgb(54, 162, 235)',
                            backgroundColor: 'rgba(54, 162, 235, 0.1)',
                            yAxisID: 'y',
                            tension: 0.4
                        },
                        {
                            label: 'Revenus (DT)',
                            data: {{ mois_revenus|raw }},
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.1)',
                            yAxisID: 'y1',
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { position: 'top' } },
                    scales: {
                        y:  { type: 'linear', position: 'left',  title: { display: true, text: 'Nb Ventes' } },
                        y1: { type: 'linear', position: 'right', title: { display: true, text: 'Revenus (DT)' }, grid: { drawOnChartArea: false } }
                    }
                }
            });
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
{% endblock %}