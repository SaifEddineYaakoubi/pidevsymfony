{# Partial for AJAX: stats + table #}

<div class="mt-3 d-flex flex-wrap align-items-center" style="gap: 1rem;">
    {% set counts = stats.counts_by_status ?? {} %}

    <!-- Statistiques principales -->
    <div class="d-flex align-items-center">
        <i class="fas fa-warehouse text-primary mr-2"></i>
        <span class="badge badge-primary px-3 py-2">
            <strong>{{ stats.total_all ?? '?' }}</strong> stocks au total
        </span>
    </div>

    <div class="d-flex align-items-center">
        <i class="fas fa-eye text-info mr-2"></i>
        <span class="badge badge-info px-3 py-2">
            <strong>{{ stats.total_filtered ?? stocks|length }}</strong> affichés
        </span>
    </div>

    {% if q is defined and q|trim != '' %}
        <div class="d-flex align-items-center">
            <i class="fas fa-filter text-secondary mr-2"></i>
            <span class="badge badge-light px-3 py-2 border">
                Filtre : "<strong>{{ q|e }}</strong>"
            </span>
        </div>
    {% endif %}

    <!-- Statistiques par statut -->
    {% if counts is not empty %}
        <div class="ml-3 d-flex flex-wrap" style="gap: 0.5rem;">
            {% for status, nb in counts %}
                {% set statusLower = status|lower %}
                {% set color = 'secondary' %}
                {% set icon = 'fas fa-question-circle' %}
                {% set customStyle = '' %}
                {% if statusLower == 'disponible' %}
                    {% set color = 'custom' %}
                    {% set icon = 'fas fa-check-circle' %}
                    {% set customStyle = 'background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; border: none;' %}
                {% elseif statusLower == 'expiration proche' %}
                    {% set color = 'custom' %}
                    {% set icon = 'fas fa-exclamation-triangle' %}
                    {% set customStyle = 'background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%); color: black; border: none;' %}
                {% elseif statusLower == 'expiré' %}
                    {% set color = 'custom' %}
                    {% set icon = 'fas fa-times-circle' %}
                    {% set customStyle = 'background: linear-gradient(135deg, #dc3545 0%, #8b0000 100%); color: white; border: none;' %}
                {% endif %}
                {% if color == 'custom' %}
                    <span class="badge px-3 py-2" style="{{ customStyle }}">
                        <i class="{{ icon }} mr-1"></i>{{ status }} <strong>({{ nb }})</strong>
                    </span>
                {% else %}
                    <span class="badge badge-{{ color }} px-3 py-2">
                        <i class="{{ icon }} mr-1"></i>{{ status }} <strong>({{ nb }})</strong>
                    </span>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>

<div class="mt-4">
    <table class="table table-hover table-striped text-nowrap mb-0">
        <thead class="thead-light">
        <tr>
            <th><i class="fas fa-box mr-2"></i>Produit</th>
            <th><i class="fas fa-hashtag mr-2"></i>Quantité</th>
            <th><i class="fas fa-calendar-plus mr-2"></i>Date d'entrée</th>
            <th><i class="fas fa-calendar-times mr-2"></i>Date d'expiration</th>
            <th><i class="fas fa-info-circle mr-2"></i>Statut</th>
            <th><i class="fas fa-user mr-2"></i>Ajouté par</th>
        </tr>
        </thead>
        <tbody>
        {% for s in stocks %}
            <tr class="align-middle">
                <td>
                    {% if s.id_produit is defined and s.id_produit %}
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle bg-primary text-white mr-3" style="width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold;">
                                {{ s.id_produit.nom|first|upper }}
                            </div>
                            <div>
                                <strong>{{ s.id_produit.nom }}</strong>
                                <br>
                                <small class="text-muted">{{ s.id_produit.type }}</small>
                            </div>
                        </div>
                    {% else %}
                        <span class="text-muted fst-italic">
                            <i class="fas fa-exclamation-triangle mr-1"></i>Produit supprimé
                        </span>
                    {% endif %}
                </td>
                <td>
                    <span class="badge badge-light text-dark px-3 py-2 font-weight-bold">
                        <i class="fas fa-cubes mr-1"></i>{{ s.quantite }}
                    </span>
                </td>
                <td>
                    {% if s.date_entree %}
                        <div class="d-flex align-items-center">
                            <i class="fas fa-calendar-day text-primary mr-2"></i>
                            <span>{{ s.date_entree|date('d/m/Y') }}</span>
                        </div>
                        <small class="text-muted">{{ s.date_entree|date('H:i') }}</small>
                    {% else %}
                        <span class="text-muted">-</span>
                    {% endif %}
                </td>
                <td>
                    {% if s.date_expiration %}
                        {% set now = 'now'|date('U') %}
                        {% set expTime = s.date_expiration|date('U') %}
                        {% set daysLeft = (expTime - now) / 86400 %}

                        <div class="d-flex align-items-center">
                            {% if expTime < now %}
                                <i class="fas fa-calendar-times text-danger mr-2"></i>
                            {% elseif daysLeft <= 30 %}
                                <i class="fas fa-exclamation-triangle text-warning mr-2"></i>
                            {% else %}
                                <i class="fas fa-calendar-check text-success mr-2"></i>
                            {% endif %}
                            <span>{{ s.date_expiration|date('d/m/Y') }}</span>
                        </div>
                        {% if daysLeft > 0 %}
                            <small class="text-muted">{{ daysLeft|round }} jour(s) restant(s)</small>
                        {% else %}
                            <small class="text-danger">Expiré depuis {{ (-daysLeft)|round }} jour(s)</small>
                        {% endif %}
                    {% else %}
                        <span class="text-muted">-</span>
                    {% endif %}
                </td>
                <td>
                    {% set now = 'now'|date('U') %}
                    {% set expTime = s.date_expiration ? s.date_expiration|date('U') : null %}
                    {% if expTime and expTime < now %}
                        <span class="badge px-3 py-2" style="background: linear-gradient(135deg, #dc3545 0%, #8b0000 100%); color: white; border: none;">
                            <i class="fas fa-times-circle mr-1"></i>Expiré
                        </span>
                    {% elseif expTime and expTime < (now + 2592000) %} {# 30 jours #}
                        <span class="badge px-3 py-2" style="background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%); color: black; border: none;">
                            <i class="fas fa-exclamation-triangle mr-1"></i>Expiration proche
                        </span>
                    {% else %}
                        <span class="badge px-3 py-2" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; border: none;">
                            <i class="fas fa-check-circle mr-1"></i>Disponible
                        </span>
                    {% endif %}
                </td>
                <td>
                    {% set authorName = null %}
                    {% if s.id_user is defined and s.id_user %}
                        {% set authorName = (s.id_user.nom ?? null) %}
                    {% endif %}

                    {% if authorName %}
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle bg-secondary text-white mr-2" style="width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                {{ s.id_user.nom|first|upper }}{{ s.id_user.prenom|first|upper }}
                            </div>
                            {{ s.id_user.nom }} {{ s.id_user.prenom }}
                        </div>
                    {% else %}
                        <span class="text-muted fst-italic">
                            <i class="fas fa-user-times mr-1"></i>Utilisateur supprimé
                        </span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-5">
                    <i class="fas fa-warehouse fa-3x mb-3 text-muted"></i>
                    <br>
                    <strong>Aucun stock trouvé</strong>
                    <br>
                    <small>Il n'y a actuellement aucun stock dans la base de données.</small>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>