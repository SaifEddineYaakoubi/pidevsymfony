{# templates/admin/pages/utilisateur_form.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ form_title }}{% endblock %}

{% block admin_page_title %}{{ form_title }}{% endblock %}

{% block admin_body %}
<div class="card">
    <div class="card-body">
        {{ form_start(form, {'action': form_action|default(app.request.uri), 'attr': {'novalidate': 'novalidate'}}) }}

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.nom, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.prenom, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.prenom) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.email, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.role, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.role) }}
                        {{ form_errors(form.role) }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.dateNaissance, 'Date de naissance', {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.dateNaissance) }}
                        {{ form_errors(form.dateNaissance) }}
                        <small class="form-text text-muted">Optionnel - Pour les statistiques</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.sexe, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.sexe) }}
                        {{ form_errors(form.sexe) }}
                        <small class="form-text text-muted">Optionnel</small>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.mot_de_passe, null, {'label_attr': {'class': 'control-label'}}) }}
                        {{ form_widget(form.mot_de_passe) }}
                        {{ form_errors(form.mot_de_passe) }}
                        <small class="form-text text-muted">Laissez vide pour conserver le mot de passe actuel (en modification)</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.statut, null, {'label_attr': {'class': 'control-label'}}) }}
                        <div class="mt-2">
                            {{ form_widget(form.statut) }}
                        </div>
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> {{ button_label }}
                    </button>
                    <a href="{{ path('app_admin_utilisateur_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}