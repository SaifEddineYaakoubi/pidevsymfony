{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Carte des Livraisons - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div style="background-color: #f8f9fa; min-height: 100vh; padding: 20px 0;">
        <div style="max-width: 1400px; margin: 0 auto; padding: 20px;">

            {# Header #}
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h1 style="margin: 0 0 5px 0; font-weight: 700; color: #1a1a2e; font-size: 1.75rem;">
                            <i class="fas fa-map-marked-alt"></i> Carte des Livraisons
                        </h1>
                        <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">Visualisation géographique de vos ventes</p>
                    </div>
                    <a href="{{ path('app_vente_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour aux ventes
                    </a>
                </div>
            </div>

            {# Statistiques par région #}
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="small text-muted">Total Ventes</div>
                                    <div class="h4 mb-0 text-primary">{{ stats.total_ventes }}</div>
                                </div>
                                <i class="fas fa-shopping-cart fa-2x text-primary opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="small text-muted">Livraisons Tunis</div>
                                    <div class="h4 mb-0 text-success">{{ stats.tunis_count }}</div>
                                    <small class="text-muted">{{ stats.tunis_percentage }}%</small>
                                </div>
                                <i class="fas fa-city fa-2x text-success opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="small text-muted">Autres Régions</div>
                                    <div class="h4 mb-0 text-info">{{ stats.autres_count }}</div>
                                    <small class="text-muted">{{ stats.autres_percentage }}%</small>
                                </div>
                                <i class="fas fa-map fa-2x text-info opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="small text-muted">Frais Totaux</div>
                                    <div class="h4 mb-0 text-warning">{{ stats.total_frais|number_format(2) }} DT</div>
                                </div>
                                <i class="fas fa-truck fa-2x text-warning opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Tableau des ventes par région #}
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0">
                        <i class="fas fa-table"></i> Détails des Livraisons par Région
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> ID</th>
                                    <th><i class="fas fa-calendar"></i> Date</th>
                                    <th><i class="fas fa-user"></i> Client</th>
                                    <th><i class="fas fa-building"></i> Ville</th>
                                    <th><i class="fas fa-map"></i> Région</th>
                                    <th><i class="fas fa-truck"></i> Frais</th>
                                    <th><i class="fas fa-money-bill-wave"></i> Montant</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for vente in ventes_avec_geo %}
                                    <tr>
                                        <td><strong>#{{ vente.idVente }}</strong></td>
                                        <td>{{ vente.dateVente|date('d/m/Y') }}</td>
                                        <td>
                                            {% if vente.idClient %}
                                                {{ vente.idClient.nom }}
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if vente.ville %}
                                                <i class="fas fa-map-marker-alt text-primary"></i> {{ vente.ville }}
                                            {% else %}
                                                <span class="text-muted">Non disponible</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if vente.region %}
                                                <span class="badge bg-light text-dark">{{ vente.region }}</span>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if vente.fraisLivraison %}
                                                {% if vente.fraisLivraison == 7 %}
                                                    <span class="badge bg-success">{{ vente.fraisLivraison }} DT</span>
                                                {% else %}
                                                    <span class="badge bg-info">{{ vente.fraisLivraison }} DT</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <strong class="text-success">{{ vente.montantTotal|number_format(2) }} DT</strong>
                                        </td>
                                        <td>
                                            <a href="{{ path('app_vente_show', {'idVente': vente.idVente}) }}" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                            Aucune vente avec géolocalisation disponible
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Répartition par région (graphique) #}
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0">
                                <i class="fas fa-chart-pie"></i> Répartition des Livraisons
                            </h5>
                        </div>
                        <div class="card-body">
                            <canvas id="regionChart" height="200"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle"></i> Informations Tarifaires
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-success mb-3">
                                <h6 class="alert-heading">
                                    <i class="fas fa-city"></i> Tarif Tunis
                                </h6>
                                <p class="mb-0">
                                    <strong>7 DT</strong> par livraison<br>
                                    <small class="text-muted">Appliqué automatiquement pour les régions contenant "Tunis"</small>
                                </p>
                            </div>
                            <div class="alert alert-info mb-3">
                                <h6 class="alert-heading">
                                    <i class="fas fa-map"></i> Tarif Standard
                                </h6>
                                <p class="mb-0">
                                    <strong>12 DT</strong> par livraison<br>
                                    <small class="text-muted">Appliqué pour toutes les autres régions de Tunisie</small>
                                </p>
                            </div>
                            <div class="alert alert-warning mb-0">
                                <h6 class="alert-heading">
                                    <i class="fas fa-exclamation-triangle"></i> Tarif par Défaut
                                </h6>
                                <p class="mb-0">
                                    <strong>12 DT</strong> par livraison<br>
                                    <small class="text-muted">Appliqué si la géolocalisation échoue</small>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {# Chart.js pour le graphique #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Données pour le graphique
        const ctx = document.getElementById('regionChart').getContext('2d');
        const regionChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Tunis (7 DT)', 'Autres Régions (12 DT)'],
                datasets: [{
                    data: [{{ stats.tunis_count }}, {{ stats.autres_count }}],
                    backgroundColor: [
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(59, 130, 246, 0.8)'
                    ],
                    borderColor: [
                        'rgba(16, 185, 129, 1)',
                        'rgba(59, 130, 246, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            font: {
                                size: 13
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.parsed || 0;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return label + ': ' + value + ' ventes (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    </script>
{% endblock %}
