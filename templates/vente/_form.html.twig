{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erreurs de validation :</strong>
            {{ form_errors(form) }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">{{ form.dateVente.vars.label }}</label>
            {{ form_widget(form.dateVente, {'attr': {'class': 'form-control'}}) }}
            {% if form.dateVente.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.dateVente) }}
                </div>
            {% endif %}
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">{{ form.montantTotal.vars.label }}</label>
            {{ form_widget(form.montantTotal, {'attr': {'class': 'form-control'}}) }}
            {% if form.montantTotal.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.montantTotal) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">{{ form.idClient.vars.label }}</label>
            {{ form_widget(form.idClient, {'attr': {'class': 'form-control'}}) }}
            {% if form.idClient.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.idClient) }}
                </div>
            {% endif %}
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">{{ form.idUser.vars.label }}</label>
            {{ form_widget(form.idUser, {'attr': {'class': 'form-control'}}) }}
            {% if form.idUser.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {{ form_errors(form.idUser) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_vente_index') }}" class="btn btn-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}
