{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Ventes - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div class="container section">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="mb-4">Gestion des Ventes</h1>

                <div class="table-responsive mb-4">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Client</th>
                                <th>Date Vente</th>
                                <th>Montant Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for vente in ventes %}
                            <tr>
                                <td>{{ vente.id_vente }}</td>
                                <td>{{ vente.id_client|safe_client_name }}</td>
                                <td>{{ vente.date_vente ? vente.date_vente|date('d/m/Y') : '-' }}</td>
                                <td>{{ vente.montant_total|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    <a href="{{ path('app_vente_show', {'id_vente': vente.id_vente}) }}" class="btn btn-sm btn-info">Voir</a>
                                    <a href="{{ path('app_vente_edit', {'id_vente': vente.id_vente}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">Aucune vente enregistrée</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <a href="{{ path('app_vente_new') }}" class="btn btn-primary">Ajouter une Vente</a>
            </div>
        </div>
    </div>
{% endblock %}
