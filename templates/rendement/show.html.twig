{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Détail du Rendement #{{ rendement.id_rendement }}{% endblock %}

{% block agriculteur_body %}

<h1>👁️ Détail du Rendement #{{ rendement.id_rendement }}</h1>

<table class="table">
    <tbody>
        <tr>
            <th>ID Rendement</th>
            <td>{{ rendement.id_rendement }}</td>
        </tr>
        <tr>
            <th>Récolte Associée</th>
            <td>
                {% if rendement.id_recolte %}
                    <strong>Récolte #{{ rendement.id_recolte.idRecolte }}</strong><br>
                    <small>Type: {{ rendement.id_recolte.typeCulture ?? 'Non défini' }}</small><br>
                    <small>Localisation: {{ rendement.id_recolte.localisation ?? 'Non définie' }}</small><br>
                    <small>Quantité: {{ rendement.id_recolte.quantite ?? 0 }} kg</small>
                {% else %}
                    <span style="color: #999;">Aucune récolte associée</span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Surface Exploitée</th>
            <td>{{ rendement.surface_exploitee }} m²</td>
        </tr>
        <tr>
            <th>Quantité Totale Récoltée</th>
            <td>{{ rendement.quantite_totale }} kg</td>
        </tr>
        <tr style="background: #f0f8ff;">
            <th>Productivité Calculée</th>
            <td><strong style="font-size: 1.2em; color: #16a34a;">{{ rendement.productivite|number_format(2, '.', '') }} kg/m²</strong></td>
        </tr>
    </tbody>
</table>

<div style="background: #e8f5e8; padding: 1rem; margin: 2rem 0; border-left: 4px solid #16a34a;">
    <h4>📐 Calcul du Rendement</h4>
    <p><strong>Formule utilisée :</strong> Productivité = Quantité Totale ÷ Surface Exploitée</p>
    <p><strong>Calcul :</strong> {{ rendement.quantite_totale }} kg ÷ {{ rendement.surface_exploitee }} m² = <strong>{{ rendement.productivite|number_format(2, '.', '') }} kg/m²</strong></p>
</div>

<!-- Section Analyse d'Impact du Sol -->
{% if yield_analysis %}
<hr>
<h3>🌱 Analyse d'Impact du Sol sur le Rendement</h3>

{% if yield_analysis.error is defined and yield_analysis.error %}
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <strong>Erreur d'analyse:</strong> {{ yield_analysis.message }}
    </div>
{% else %}
    <!-- Indicateur source des données -->
    {% if yield_analysis.api_source is defined %}
        <div class="alert alert-{{ yield_analysis.api_source == 'live' ? 'success' : 'warning' }} mb-3">
            <i class="fas fa-{{ yield_analysis.api_source == 'live' ? 'check-circle' : 'flask' }}"></i>
            <strong>Données {{ yield_analysis.api_source == 'live' ? 'réelles' : 'de test' }}</strong>
            {% if yield_analysis.api_source == 'test' %}
                - L'API AgroAPI n'est pas configurée ou indisponible. Les données affichées sont simulées pour démonstration.
                {% if yield_analysis.region_profile is defined %}
                    <br><small><i class="fas fa-map-marker-alt"></i> <strong>Région détectée:</strong> {{ yield_analysis.region_profile|replace({'_': ' '})|title }}</small>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}

    <!-- Comparaison Performance -->
    {% if yield_analysis.actual_vs_potential is defined %}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-title">Rendement Réel</h6>
                    <div class="display-4 text-primary">
                        {{ yield_analysis.productivity|number_format(2, '.', '') }}
                    </div>
                    <small class="text-muted">kg/m²</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-title">Potentiel du Sol</h6>
                    <div class="display-4 text-success">
                        {{ yield_analysis.predicted_yield_potential|number_format(2, '.', '') }}
                    </div>
                    <small class="text-muted">kg/m²</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="card-title">Efficacité d'Exploitation</h6>
                    <div class="display-4 text-info">
                        {{ yield_analysis.actual_vs_potential.efficiency }}
                    </div>
                    <small class="text-muted">% du potentiel</small>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Qualité du Sol -->
    {% if yield_analysis.soil_quality_score is defined %}
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0">Qualité du Sol</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Score Global: <span class="badge bg-{{ yield_analysis.soil_quality_score >= 60 ? 'success' : (yield_analysis.soil_quality_score >= 40 ? 'warning' : 'danger') }}">{{ yield_analysis.soil_quality_score }}/100</span></h6>
                    <div class="progress">
                        <div class="progress-bar bg-{{ yield_analysis.soil_quality_score >= 60 ? 'success' : (yield_analysis.soil_quality_score >= 40 ? 'warning' : 'danger') }}" style="width: {{ yield_analysis.soil_quality_score }}%"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6>Corrélation Sol/Rendement:</h6>
                    <p class="mb-0">{{ yield_analysis.correlation }}</p>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Facteurs Limitants -->
    {% if yield_analysis.soil_factors_affecting_yield is defined and yield_analysis.soil_factors_affecting_yield|length > 0 %}
    <div class="card mb-4">
        <div class="card-header bg-warning">
            <h6 class="mb-0">
                <i class="fas fa-exclamation"></i> Facteurs Limitants Identifiés
            </h6>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                {% for factor in yield_analysis.soil_factors_affecting_yield %}
                    <li class="list-group-item">
                        <strong>{{ factor.nutrient }}</strong>
                        <p class="mb-1">Niveau actuel: {{ factor.level }} - Statut: {{ factor.status }}</p>
                        <small class="text-muted">
                            Impact: {{ factor.impact }}
                        </small>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    <!-- Plan d'Amélioration -->
    {% if yield_analysis.recommendations_to_improve is defined and yield_analysis.recommendations_to_improve|length > 0 %}
    <div class="card mb-4">
        <div class="card-header bg-success">
            <h6 class="mb-0">
                <i class="fas fa-arrow-up"></i> Recommandations d'Amélioration
            </h6>
        </div>
        <div class="card-body">
            <ol class="mb-0">
                {% for recommendation in yield_analysis.recommendations_to_improve %}
                    <li class="mb-2">
                        <strong>{{ recommendation.action }}</strong>
                        <br><small class="text-muted">Gain attendu: {{ recommendation.expected_yield_increase }}</small>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>
    {% endif %}

{% endif %}
{% endif %}

<div style="margin-top: 2rem;">
    <a href="{{ path('app_rendement_index') }}" class="btn btn-secondary">← Retour à la liste</a>
    <a href="{{ path('app_rendement_edit', {'idRendement': rendement.id_rendement}) }}" class="btn" style="background: #8B6F47;">Modifier</a>
    <a href="{{ path('test_soil_test_rendement', {'idRendement': rendement.id_rendement}) }}" class="btn" style="background: #17a2b8;">🌱 Analyse Sol Détaillée</a>
</div>

{% endblock %}
