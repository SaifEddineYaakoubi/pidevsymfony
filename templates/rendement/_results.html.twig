{# Partial returned for AJAX: stats + table #}

<div class="crud-header">
    {% set total = stats.total_filtered ?? rendements|length %}
    {% set counts = stats.counts_by_class ?? {} %}
    {% set avg = stats.avg_productivite ?? 0 %}
    {% set max = stats.max_productivite ?? 0 %}

    {% set faible = counts.faible ?? 0 %}
    {% set moyen = counts.moyen ?? 0 %}
    {% set bon = counts.bon ?? 0 %}
    {% set eleve = counts.eleve ?? 0 %}

    <div class="agri-stats-top mb-2">
        <div class="agri-stats-title">Statistiques des rendements</div>
        <div class="agri-stats-title">Répartition par productivité</div>
    </div>


    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% set classes = ['faible','moyen','bon','eleve'] %}
        {% for c in classes %}
            {% set count = counts[c] ?? 0 %}
            {% set percent = (total > 0 ? ((count / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--{{ c }}" style="width: {{ percent }}%"></div>
        {% endfor %}
    </div>

    <div class="agri-stats-badges justify-content-end mt-2">
        <span class="badge text-bg-danger">Faible (&lt;1): {{ faible }}</span>
        <span class="badge text-bg-warning">Moyen (1-2): {{ moyen }}</span>
        <span class="badge text-bg-primary">Bon (2-3): {{ bon }}</span>
        <span class="badge text-bg-success">Élevé (≥3): {{ eleve }}</span>
    </div>
</div>

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted small">
            {{ rendements|length }} résultat(s){% if q %} pour "{{ q }}"{% endif %}
        </div>
    </div>

    <div class="row g-3" id="rendementCards">
        {% for rendement in rendements %}
            <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="card h-100 agri-card"
                     role="button"
                     data-card-type="rendement"
                     data-id="{{ rendement.id_rendement }}"
                     data-href="{{ path('app_rendement_show', {'idRendement': rendement.id_rendement}) }}"
                     style="cursor: pointer; transition: all 0.2s ease; background: linear-gradient(135deg, rgba(34, 139, 34, 0.12), rgba(50, 205, 50, 0.10)) !important;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title text-truncate mb-1">
                                {% if rendement.id_recolte %}
                                    Récolte du {{ rendement.id_recolte.dateRecolte ? rendement.id_recolte.dateRecolte|date('d/m/Y') : 'Date inconnue' }}
                                {% else %}
                                    Rendement non associé
                                {% endif %}
                            </h5>
                            <span class="badge bg-primary fs-6">
                                <i class="fas fa-chart-line me-1"></i>
                                {{ rendement.productivite|number_format(2, '.', '') }} kg/m²
                            </span>
                        </div>

                        {% if rendement.id_recolte %}
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="fas fa-seedling me-1"></i>
                                    {{ rendement.id_recolte.typeCulture ?? 'Type non défini' }}
                                </small>
                            </div>
                        {% endif %}

                        <div class="mb-2">
                            <strong class="text-info">{{ rendement.quantite_totale }} kg</strong>
                            <small class="text-muted">récoltés</small>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="fas fa-expand-arrows-alt me-1"></i>
                                {{ rendement.surface_exploitee }} m²
                            </small>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary flex-fill" href="{{ path('app_rendement_show', {'idRendement': rendement.id_rendement}) }}">Voir</a>
                            <a class="btn btn-sm btn-outline-secondary flex-fill" href="{{ path('app_rendement_edit', {'idRendement': rendement.id_rendement}) }}">Modifier</a>
                            <form method="post"
                                  action="{{ path('app_rendement_delete', {'idRendement': rendement.id_rendement}) }}"
                                  class="d-inline flex-fill"
                                  onsubmit="return confirm('Êtes-vous sûr?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rendement.id_rendement) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center text-muted py-5">
                    <i class="fas fa-chart-line fa-3x mb-3"></i>
                    <p>Aucun rendement trouvé</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

