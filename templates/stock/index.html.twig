{% extends 'front/base_stock.html.twig' %}

{% block title %}Gestion du Stock{% endblock %}

{% block agriculteur_body %}
    <div class="container section py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h2 mb-2" style="color: #2E8B57;">📦 Gestion du Stock</h1>
                <p class="text-muted">Suivez vos entrées de stock et modifiez les quantités en quelques clics.</p>
            </div>
            <div class="gap-2" style="display: flex; gap: 10px;">
                <a href="{{ path('stock_export_pdf') }}" class="btn btn-lg rounded-3 shadow-sm" style="background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%); color: white; border: none;">
                    <i class="bi bi-file-pdf me-2"></i>Exporter PDF
                </a>
                <a href="{{ path('stock_new') }}" class="btn btn-lg rounded-3 shadow-sm" style="background: linear-gradient(135deg, #87CEEB 0%, #4682B4 100%); color: white; border: none;">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter du stock
                </a>
            </div>
        </div>

        {% if app.request.query.get('export') %}
            <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Succès !</strong> Le fichier PDF a été téléchargé avec succès.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        <div class="card shadow-sm rounded-4 border-0 mb-4">
            <div class="card-body bg-light rounded-4">
                <form id="stock-filter-form" method="get" action="{{ path('stock_index') }}" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold text-dark" for="stock-search">🔍 Rechercher</label>
                        <input type="search" id="stock-search" name="q" value="{{ search }}" class="form-control form-control-lg rounded-3" placeholder="Entrez le produit ou référence...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark" for="stock-search-field">Critère</label>
                        <select id="stock-search-field" name="searchField" class="form-select form-select-lg rounded-3">
                            {% for value, label in searchOptions %}
                                <option value="{{ value }}"{{ value == searchField ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark" for="stock-sort">Trier par</label>
                        <select id="stock-sort" name="sort" class="form-select form-select-lg rounded-3">
                            {% for value, label in sortOptions %}
                                <option value="{{ value }}"{{ value == sort ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-4">
            {% for stock in stocks %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 border-0">
                        <div class="card-header bg-success text-white">
                            <h5 class="card-title mb-0">
                                {% set produit = stock.id_produit ?? null %}
                                {% if produit is not null %}
                                    {% if produit.icon is defined and produit.icon is not empty %}
                                        {{ produit.icon }}
                                    {% endif %}
                                    {{ produit.nom }}
                                {% else %}
                                    Produit supprimé
                                {% endif %}
                            </h5>
                        </div>
                        <div class="card-body" style="padding: 1.5rem;">
                            <div class="mb-3 pb-2" style="border-bottom: 2px solid #f0f0f0;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 1.4rem;">📊</span>
                                    <span>{{ stock.quantite }} {{ stock.id_produit.unite ?? 'unité' }}</span>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="text-muted small fw-semibold" style="color: #7F8C8D !important;">📅 Entrée</label>
                                    <p class="mb-0 small" style="color: #2C3E50; font-weight: 500;">{{ stock.date_entree ? stock.date_entree|date('d/m/Y') : '—' }}</p>
                                </div>
                                <div class="col-6">
                                    <label class="text-muted small fw-semibold" style="color: #7F8C8D !important;">⏰ Expiration</label>
                                    <p class="mb-0 small" style="color: #2C3E50; font-weight: 500;">
                                        {% if stock.date_expiration %}
                                            {{ stock.date_expiration|date('d/m/Y') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="btn-group w-100">
                                <a href="{{ path('stock_show', {'id_stock': stock.id_stock}) }}" class="btn btn-outline-primary">Voir</a>
                                <a href="{{ path('stock_edit', {'id_stock': stock.id_stock}) }}" class="btn btn-outline-secondary">Éditer</a>
                                <form method="post" action="{{ path('stock_delete', {'id_stock': stock.id_stock}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id_stock) }}">
                                    <button class="btn btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette entrée de stock ?');">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="card shadow-sm rounded-4 border-0">
                        <div class="card-body py-5 text-center">
                            <p class="text-muted mb-0">📭 Aucune entrée de stock trouvée.</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <script>
        const stockFilterForm = document.getElementById('stock-filter-form');
        const stockSearch = document.getElementById('stock-search');

        if (stockFilterForm) {
            stockSearch.addEventListener('input', () => {
                clearTimeout(window.stockSearchTimeout);
                window.stockSearchTimeout = setTimeout(() => stockFilterForm.submit(), 300);
            });

            document.querySelectorAll('#stock-sort, #stock-search-field').forEach((el) => {
                el.addEventListener('change', () => stockFilterForm.submit());
            });
        }

        // Export PDF handler
        document.addEventListener('click', function(e) {
            if (e.target.closest('a[href*="stock_export_pdf"]') || e.target.closest('a[href*="/stock/crud/export-pdf"]')) {
                setTimeout(function() {
                    const html = `<div class="alert alert-success alert-dismissible fade show rounded-3 position-fixed" style="top: 20px; right: 20px; z-index: 1050; min-width: 300px;" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Succès !</strong> Le fichier PDF a été téléchargé avec succès.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>`;
                    document.body.insertAdjacentHTML('beforeend', html);
                    setTimeout(function() {
                        const alert = document.querySelector('.alert-success.position-fixed');
                        if (alert) alert.remove();
                    }, 5000);
                }, 300);
            }
        });
    </script>
{% endblock %}
