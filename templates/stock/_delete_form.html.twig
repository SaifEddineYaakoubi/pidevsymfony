<form method="post" action="{{ path('stock_delete', {'id_stock': stock.idStock}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette entrée de stock ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.idStock) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
