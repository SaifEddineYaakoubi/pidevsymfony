<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport du Stock</title>
    <style>
        * {
            margin: 0;
            padding: 0;
        }
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            color: #333;
            background-color: #f9f9f9;
        }
        .header {
            background: linear-gradient(135deg, #0dcaf0 0%, #0da5d0 100%);
            color: white;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
        }
        .header h1 {
            font-size: 28px;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 12px;
            opacity: 0.9;
        }
        .info-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .info-item {
            font-size: 11px;
        }
        .info-item strong {
            color: #0dcaf0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        thead {
            background-color: #0dcaf0;
            color: white;
        }
        th {
            padding: 12px;
            text-align: left;
            font-weight: bold;
            font-size: 11px;
            border: 1px solid #0dcaf0;
        }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid #eee;
            font-size: 11px;
        }
        tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tbody tr:hover {
            background-color: #f0f0f0;
        }
        .footer {
            margin-top: 30px;
            padding-top: 10px;
            border-top: 1px solid #ddd;
            font-size: 10px;
            color: #999;
            text-align: center;
        }
        .badge {
            background-color: #e9ecef;
            color: #333;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 9px;
            display: inline-block;
        }
        .quantity {
            background-color: #d4edda;
            color: #155724;
            padding: 3px 8px;
            border-radius: 3px;
            font-weight: bold;
            display: inline-block;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📦 Rapport du Stock</h1>
        <p>Export généré le {{ generatedDate|date('d/m/Y à H:i:s') }}</p>
    </div>

    <div class="info-section">
        <div class="info-item">
            <strong>Total Entrées Stock:</strong> {{ stocks|length }}
        </div>
        <div class="info-item">
            <strong>Date d'Édition:</strong> {{ "now"|date('d/m/Y') }}
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Date Entrée</th>
                <th>Date Expiration</th>
                <th>Utilisateur</th>
            </tr>
        </thead>
        <tbody>
            {% for stock in stocks %}
                <tr>
                    <td><span class="badge">{{ stock.idStock }}</span></td>
                    <td>{{ stock.idProduit.icon }} {{ stock.idProduit.nom }}</td>
                    <td><span class="quantity">{{ stock.quantite }}</span></td>
                    <td>{{ stock.dateEntree ? stock.dateEntree|date('d/m/Y') : '—' }}</td>
                    <td>{{ stock.dateExpiration ? stock.dateExpiration|date('d/m/Y') : '—' }}</td>
                    <td>U#{{ stock.idUser }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; color: #999;">Aucune entrée de stock disponible</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        <p>Ce document a été généré automatiquement par le système de gestion Smart Farm</p>
    </div>
</body>
</html>
