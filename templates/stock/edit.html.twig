{% extends 'front/base_stock.html.twig' %}

{% block title %}Modifier l'entrée de Stock{% endblock %}

{% block agriculteur_body %}
    <div class="container section py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm rounded-4 border-0 overflow-hidden">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #D4A574 0%, #C19A6B 100%);">
                        <h3 class="mb-0 text-white fw-bold"><i class="bi bi-pencil-square me-2"></i>Modifier le stock</h3>
                    </div>
                    <div class="card-body p-5">
                        {{ form_start(form, {'attr': {'class': 'form-validation'}}) }}

                        <div class="row g-4">
                            <div class="col-md-6">
                                {{ form_label(form.quantite, 'Quantité', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.quantite, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': '0.00', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.quantite) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.id_produit, 'Produit', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.id_produit, {'attr': {'class': 'form-select form-select-lg rounded-3', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.id_produit) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.date_entree, 'Date d\'entrée', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.date_entree, {'attr': {'class': 'form-control form-control-lg rounded-3', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.date_entree) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.date_expiration, 'Date d\'expiration', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.date_expiration, {'attr': {'class': 'form-control form-control-lg rounded-3', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.date_expiration) }}</small>
                            </div>
                            <div class="col-12">
                                {{ form_label(form.id_user, 'ID utilisateur', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.id_user, {'attr': {'class': 'form-control form-control-lg rounded-3', 'required': 'required'}}) }}
                            </div>
                        </div>

                        <div class="mt-5 d-flex justify-content-between gap-3">
                            <a href="{{ path('stock_index') }}" class="btn btn-lg rounded-3" style="background-color: #D4A574; color: white; border: none; font-weight: 500;">
                                <i class="bi bi-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-lg rounded-3 shadow-sm" style="background: linear-gradient(135deg, #2E8B57 0%, #3CAA6F 100%); color: white; border: none; font-weight: 500;">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
