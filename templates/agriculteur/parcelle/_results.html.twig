{# Partial returned for AJAX: stats + table #}


<div class="mt-3 d-flex flex-wrap gap-3 align-items-center">
    <span class="agri-badge"><strong>Total (DB):</strong> {{ stats.total_all ?? parcelles|length }}</span>
    <span class="agri-badge"><strong>Affichés:</strong> {{ stats.total_filtered ?? parcelles|length }}</span>

    {% set etats = ['active','repos','exploitee'] %}
    {% set etatLabels = {
        'active': 'Active',
        'repos': 'Repos',
        'exploitee': 'Exploitée'
    } %}
    {% for e in etats %}
        <span class="agri-badge agri-badge--{{ e }}">
            {{ etatLabels[e] ?? e }}: {{ stats.counts_by_etat[e] ?? 0 }}
        </span>
    {% endfor %}
</div>

<div class="mt-3">
    {% include 'agriculteur/parcelle/_table.html.twig' %}
</div>

