{# Partial returned for AJAX: stats + table #}


<div class="crud-header">
    {% set total = stats.total_filtered ?? parcelles|length %}
    {% set counts = stats.counts_by_etat ?? {} %}
    {% set activeCount = counts.active ?? 0 %}
    {% set reposCount = counts.repos ?? 0 %}
    {% set exploiteeCount = counts.exploitee ?? 0 %}

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="small text-muted">Statistiques des parcelles</div>
        <div class="small text-muted">Répartition des états</div>
    </div>



    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% set etats = ['active','repos','exploitee'] %}
        {% for e in etats %}
            {% set count = stats.counts_by_etat[e] ?? 0 %}
            {% set percent = (total > 0 ? ((count / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--{{ e }}" style="width: {{ percent }}%"></div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-end flex-wrap gap-2 mt-2">
        <span class="badge text-bg-success">Active: {{ activeCount }}</span>
        <span class="badge text-bg-secondary">Repos: {{ reposCount }}</span>
        <span class="badge text-bg-primary">Exploitée: {{ exploiteeCount }}</span>
    </div>
</div>

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted small">
            {{ parcelles|length }} résultat(s)
            {% if q %}pour "{{ q }}"{% endif %}
        </div>
    </div>

    <div class="row g-3">
        {% for p in parcelles %}
            {% set etatLabel = {
                'active': 'Active',
                'repos': 'Repos',
                'exploitee': 'Exploitée'
            }[p.etat] ?? p.etat %}

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm h-100 agri-parcelle-card"
                     role="button"
                     tabindex="0"
                     data-id="{{ p.id_parcelle }}"
                     data-href="{{ path('agri_parcelle_show', {id: p.id_parcelle}) }}"
                     data-delete-token="{{ csrf_token('delete_parcelle_' ~ p.id_parcelle) }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <div class="text-muted small">Parcelle</div>
                                <div class="h5 mb-1">
                                    <a class="text-decoration-none" href="{{ path('agri_parcelle_show', {id: p.id_parcelle}) }}">
                                        {{ p.nom }}
                                    </a>
                                </div>
                            </div>
                            <div>
                                <span class="agri-badge agri-badge--{{ p.etat }}">{{ etatLabel }}</span>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="d-grid" style="row-gap: .5rem;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Superficie</span>
                                <strong>{{ p.superficie }}</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Localisation</span>
                                <strong class="text-end" style="max-width: 65%;">{{ p.localisation }}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <div class="d-flex justify-content-end">
                            <span class="text-muted small">Double-clic : détails</span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center text-muted py-4">Aucune parcelle</div>
            </div>
        {% endfor %}
    </div>
</div>

