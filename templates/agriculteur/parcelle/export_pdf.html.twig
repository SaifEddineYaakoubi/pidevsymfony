<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Export Parcelles</title>
    <style>
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 12px; color: #1f2937; }
        h1 { font-size: 18px; margin: 0 0 12px; }
        .meta { font-size: 11px; color: #555; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        th { background: #1b7f3a; color: #fff; text-align: left; }
        .etat { font-weight: bold; }
    </style>
</head>
<body>
<h1>Liste des parcelles</h1>
<div class="meta">
    Exporté le {{ exportedAt|date('d/m/Y H:i') }}
    {% if q %} — Recherche: "{{ q }}"{% endif %}
</div>

<table>
    <thead>
    <tr>
        <th>Nom</th>
        <th>Superficie</th>
        <th>Localisation</th>
        <th>État</th>
    </tr>
    </thead>
    <tbody>
    {% for p in parcelles %}
        <tr>
            <td>{{ p.nom }}</td>
            <td>{{ p.superficie }}</td>
            <td>{{ p.localisation }}</td>
            <td class="etat">
                {% set etatLabel = {'active':'Active','repos':'Repos','exploitee':'Exploitée'}[p.etat] ?? p.etat %}
                {{ etatLabel }}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="4">Aucune parcelle</td></tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>

