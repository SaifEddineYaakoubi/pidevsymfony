{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Parcelles - AgriCulture{% endblock %}

{% block agriculteur_body %}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'Parcelles',
        breadcrumbs: [
            { label: 'Home', route: 'app_agriculteur_home' },
            { label: 'Parcelles' }
        ]
    } %}

    <section class="section">
        <div class="container">

            <div class="agri-crud">

            {% for label, messages in app.flashes %}
                {% for msg in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ msg }}</div>
                {% endfor %}
            {% endfor %}

            <div class="crud-header mb-4"
                 data-controller="crud-search"
                 data-crud-search-url-value="{{ path('agri_parcelle_index') }}">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-8">
                        <form class="d-flex gap-2" method="get">
                            <input class="form-control"
                                   name="q"
                                   value="{{ q }}"
                                   placeholder="Rechercher (nom, localisation, état)"
                                   autocomplete="off"
                                   data-crud-search-target="input"
                                   data-action="input->crud-search#search">
                            <input type="hidden" name="sort" value="{{ sort|default('nom') }}">
                            <input type="hidden" name="dir" value="{{ dir|default('ASC') }}">

                            {% if q %}
                                <a class="btn btn-outline-secondary" href="{{ path('agri_parcelle_index', {sort: sort|default('nom'), dir: dir|default('ASC')}) }}">Effacer</a>
                            {% endif %}
                        </form>
                    </div>
                    <div class="col-lg-4 text-lg-end d-flex gap-2 justify-content-lg-end">
                        <a id="btnExportPdf" class="btn btn-outline-success" href="{{ path('agri_parcelle_export_pdf') }}">Exporter PDF</a>
                        <a class="btn btn-success" href="{{ path('agri_parcelle_new') }}">Ajouter</a>
                        <a id="btnEdit" class="btn btn-outline-primary disabled" href="#">Modifier</a>
                        <form id="deleteForm" method="post" class="m-0">
                            <input type="hidden" name="_token" id="deleteToken" value="">
                            <button id="btnDelete" class="btn btn-outline-danger" type="submit" disabled>Supprimer</button>
                        </form>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap justify-content-end align-items-center gap-2">
                    <label class="small text-muted align-self-center">Trier par</label>
                    <select class="form-select form-select-sm"
                            name="sort"
                            data-crud-search-target="sort"
                            data-action="change->crud-search#sortChanged">
                        <option value="nom" {{ (sort|default('nom')) == 'nom' ? 'selected' : '' }}>Nom</option>
                        <option value="superficie" {{ (sort|default('nom')) == 'superficie' ? 'selected' : '' }}>Superficie</option>
                        <option value="localisation" {{ (sort|default('nom')) == 'localisation' ? 'selected' : '' }}>Localisation</option>
                        <option value="etat" {{ (sort|default('nom')) == 'etat' ? 'selected' : '' }}>État</option>
                    </select>
                    <select class="form-select form-select-sm"
                            name="dir"
                            data-crud-search-target="dir"
                            data-action="change->crud-search#sortChanged">
                        <option value="ASC" {{ (dir|default('ASC')) == 'ASC' ? 'selected' : '' }}>↑</option>
                        <option value="DESC" {{ (dir|default('ASC')) == 'DESC' ? 'selected' : '' }}>↓</option>
                    </select>
                </div>

                {# Stats moved into results partial so AJAX updates them too #}
            </div>

            <div class="agri-crud-results" data-crud-search-target="results">
                <div class="agri-crud-loader" aria-hidden="true">
                </div>
                {% include 'agriculteur/parcelle/_results.html.twig' %}
            </div>
            </div>
        </div>
    </section>

    <script>
        (function() {
            const btnExportPdf = document.getElementById('btnExportPdf');
            const btnEdit = document.getElementById('btnEdit');
            const btnDelete = document.getElementById('btnDelete');
            const deleteForm = document.getElementById('deleteForm');
            const deleteToken = document.getElementById('deleteToken');
            const results = document.querySelector('[data-crud-search-target="results"]');

            // Build export URL from current UI state (works with AJAX search/sort)
            if (btnExportPdf) {
                btnExportPdf.addEventListener('click', (e) => {
                    e.preventDefault();

                    const qEl = document.querySelector('[data-crud-search-target="input"]');
                    const sortEl = document.querySelector('[data-crud-search-target="sort"]');
                    const dirEl = document.querySelector('[data-crud-search-target="dir"]');

                    const url = new URL(btnExportPdf.getAttribute('href'), window.location.origin);
                    if (qEl && qEl.value.trim() !== '') url.searchParams.set('q', qEl.value.trim());
                    if (sortEl && sortEl.value) url.searchParams.set('sort', sortEl.value);
                    if (dirEl && dirEl.value) url.searchParams.set('dir', dirEl.value);

                    window.location.href = url.toString();
                });
            }

            function clearSelection() {
                const table = document.getElementById('parcelleTable');
                if (!table) return;
                table.querySelectorAll('tbody tr').forEach(tr => tr.classList.remove('is-selected'));
            }

            function setSelected(row) {
                clearSelection();
                row.classList.add('is-selected');
                const selectedId = row.dataset.id;

                btnEdit.classList.remove('disabled');
                btnEdit.href = '{{ path('agri_parcelle_edit', {'id': '0'}) }}'.replace('/0', '/' + selectedId);

                btnDelete.disabled = false;
                deleteForm.action = '{{ path('agri_parcelle_delete', {'id': '0'}) }}'.replace('/0/delete', '/' + selectedId + '/delete');
                deleteToken.value = row.dataset.deleteToken;
            }

            results.addEventListener('click', (e) => {
                const row = e.target.closest('tr[data-id]');
                if (!row) return;
                setSelected(row);
            });

            // Open details on double click anywhere on the row (except when selecting text)
            results.addEventListener('dblclick', (e) => {
                const row = e.target.closest('tr[data-id][data-href]');
                if (!row) return;
                const href = row.dataset.href;
                if (href) window.location.href = href;
            });

            document.addEventListener('crud:results-updated', () => {
                // reset actions when results change
                btnEdit.classList.add('disabled');
                btnEdit.href = '#';
                btnDelete.disabled = true;
                deleteToken.value = '';
                deleteForm.action = '';
            });
        })();
    </script>

    {# Fallback: if Stimulus is not running for some reason, still do live search #}
    <script>
        (function() {
            const wrapper = document.querySelector('[data-controller="crud-search"]');
            const input = document.querySelector('[data-crud-search-target="input"]');
            const sort = document.querySelector('[data-crud-search-target="sort"]');
            const dir = document.querySelector('[data-crud-search-target="dir"]');
            const results = document.querySelector('[data-crud-search-target="results"]');
            if (!wrapper || !input || !results) return;

            let timer = null;
            async function doSearch() {
                const q = input.value || '';
                const url = new URL(wrapper.getAttribute('data-crud-search-url-value'), window.location.origin);
                url.searchParams.set('q', q);
                if (sort) url.searchParams.set('sort', sort.value);
                if (dir) url.searchParams.set('dir', dir.value);
                const loader = results.querySelector('.agri-crud-loader');
                results.classList.add('is-loading');
                try {
                    const res = await fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) {
                        return;
                    }
                    results.innerHTML = await res.text();
                    if (loader) results.prepend(loader);
                    document.dispatchEvent(new CustomEvent('crud:results-updated'));
                } catch (e) {
                    // ignore network errors
                } finally {
                    results.classList.remove('is-loading');
                }
            }

            input.addEventListener('input', () => {
                window.clearTimeout(timer);
                timer = window.setTimeout(doSearch, 250);
            });

            if (sort) sort.addEventListener('change', doSearch);
            if (dir) dir.addEventListener('change', doSearch);
        })();
    </script>
{% endblock %}

