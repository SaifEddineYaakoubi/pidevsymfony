{# Partial returned for AJAX: stats + table #}

{% if alerts is defined and alerts|length > 0 %}
    <div class="alert alert-warning mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong>Alertes cultures</strong>
                <span class="small text-muted">(récolte prévue dans moins de 7 jours)</span>
            </div>
            <div class="small">{{ alerts|length }} alerte(s)</div>
        </div>

        <div class="mt-2">
            <ul class="mb-0">
                {% for a in alerts %}
                    {% set c = a.culture %}
                    <li>
                        <a href="{{ path('agri_culture_show', {id: c.id_culture}) }}" class="text-decoration-none">
                            {{ c.typeCulture ?? c.type_culture ?? 'Culture' }}
                        </a>
                        — parcelle: <strong>{{ c.parcelle ? c.parcelle.nom : '-' }}</strong>
                        — récolte dans <strong>{{ a.days_left }}</strong> jour(s)
                        ({% if c.dateRecoltePrevue %}{{ c.dateRecoltePrevue|date('d/m/Y') }}{% else %}-{% endif %})
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}


<div class="crud-header">
    {% set total = stats.total_filtered ?? cultures|length %}
    {% set counts = stats.counts_by_etat ?? {} %}

    <div class="agri-kpis">
        <div class="agri-kpi">
            <div class="agri-kpi__icon"><i class="bi bi-collection"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Affichés</div>
                <div class="agri-kpi__value">{{ total }}</div>
            </div>
        </div>



        <div class="agri-kpi agri-kpi--warning">
            <div class="agri-kpi__icon"><i class="bi bi-alarm"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Alertes</div>
                <div class="agri-kpi__value">{{ alerts is defined ? (alerts|length) : 0 }}</div>
            </div>
        </div>

        <div class="agri-kpi agri-kpi--germination">
            <div class="agri-kpi__icon"><i class="bi bi-flower1"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Germination</div>
                <div class="agri-kpi__value">{{ counts.germination ?? 0 }}</div>
            </div>
        </div>

        <div class="agri-kpi agri-kpi--croissance">
            <div class="agri-kpi__icon"><i class="bi bi-graph-up"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Croissance</div>
                <div class="agri-kpi__value">{{ counts.croissance ?? 0 }}</div>
            </div>
        </div>

        <div class="agri-kpi agri-kpi--floraison">
            <div class="agri-kpi__icon"><i class="bi bi-brightness-high"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Floraison</div>
                <div class="agri-kpi__value">{{ counts.floraison ?? 0 }}</div>
            </div>
        </div>

        <div class="agri-kpi agri-kpi--maturite">
            <div class="agri-kpi__icon"><i class="bi bi-award"></i></div>
            <div class="agri-kpi__body">
                <div class="agri-kpi__label">Mature</div>
                <div class="agri-kpi__value">{{ counts.maturite ?? 0 }}</div>
            </div>
        </div>
    </div>

    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% set etats = ['germination','croissance','floraison','maturite'] %}
        {% for e in etats %}
            {% set count = counts[e] ?? 0 %}
            {% set percent = (total > 0 ? ((count / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--{{ e }}" style="width: {{ percent }}%"></div>
        {% endfor %}
    </div>
</div>

<div class="mt-3">
    {% include 'agriculteur/culture/_table.html.twig' %}
</div>

