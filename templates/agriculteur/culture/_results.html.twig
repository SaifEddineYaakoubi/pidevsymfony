{# Partial returned for AJAX: stats + table #}

{% if alerts is defined and alerts|length > 0 %}
    <div class="alert alert-warning mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong>Alertes cultures</strong>
                <span class="small text-muted">(récolte prévue dans moins de 7 jours)</span>
            </div>
            <div class="small">{{ alerts|length }} alerte(s)</div>
        </div>

        <div class="mt-2">
            <ul class="mb-0">
                {% for a in alerts %}
                    {% set c = a.culture %}
                    <li>
                        <a href="{{ path('agri_culture_show', {id: c.id_culture}) }}" class="text-decoration-none">
                            {{ c.typeCulture ?? c.type_culture ?? 'Culture' }}
                        </a>
                        — parcelle: <strong>{{ c.parcelle ? c.parcelle.nom : '-' }}</strong>
                        — récolte dans <strong>{{ a.days_left }}</strong> jour(s)
                        ({% if c.dateRecoltePrevue %}{{ c.dateRecoltePrevue|date('d/m/Y') }}{% else %}-{% endif %})
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}


<div class="crud-header">
    {% set total = stats.total_filtered ?? cultures|length %}
    {% set counts = stats.counts_by_etat ?? {} %}

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="small text-muted">Statistiques des cultures</div>
        <div class="small text-muted">Répartition des états</div>
    </div>



    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% set etats = ['germination','croissance','floraison','maturite'] %}
        {% for e in etats %}
            {% set count = counts[e] ?? 0 %}
            {% set percent = (total > 0 ? ((count / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--{{ e }}" style="width: {{ percent }}%"></div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-end flex-wrap gap-2 mt-2">
        <span class="badge text-bg-dark">Affichés: {{ total }}</span>
        <span class="badge text-bg-warning">Alertes: {{ alerts is defined ? (alerts|length) : 0 }}</span>
        <span class="badge" style="background:#6f42c1;">Germination: {{ counts.germination ?? 0 }}</span>
        <span class="badge text-bg-success">Croissance: {{ counts.croissance ?? 0 }}</span>
        <span class="badge text-bg-warning">Floraison: {{ counts.floraison ?? 0 }}</span>
        <span class="badge text-bg-danger">Mature: {{ counts.maturite ?? 0 }}</span>
    </div>
</div>

<div class="mt-3">
    {% include 'agriculteur/culture/_table.html.twig' %}
</div>

