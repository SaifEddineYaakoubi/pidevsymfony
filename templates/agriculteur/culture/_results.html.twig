{# Partial returned for AJAX: stats + table #}

{% if alerts is defined and alerts|length > 0 %}
    <div class="alert alert-warning mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong>Alertes cultures</strong>
                <span class="small text-muted">(récolte prévue dans moins de 7 jours)</span>
            </div>
            <div class="small">{{ alerts|length }} alerte(s)</div>
        </div>

        <div class="mt-2">
            <ul class="mb-0">
                {% for a in alerts %}
                    {% set c = a.culture %}
                    <li>
                        <a href="{{ path('agri_culture_show', {id: c.id_culture}) }}" class="text-decoration-none">
                            {{ c.typeCulture ?? c.type_culture ?? 'Culture' }}
                        </a>
                        — parcelle: <strong>{{ c.parcelle ? c.parcelle.nom : '-' }}</strong>
                        — récolte dans <strong>{{ a.days_left }}</strong> jour(s)
                        ({% if c.dateRecoltePrevue %}{{ c.dateRecoltePrevue|date('d/m/Y') }}{% else %}-{% endif %})
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}


<div class="crud-header">
    {% set total = stats.total_filtered ?? cultures|length %}
    {% set counts = stats.counts_by_etat ?? {} %}

    <div class="row g-3 mb-4">
        <!-- Stat: Nombre total -->
        <div class="col-md-4">
            <div class="p-3 bg-light rounded text-center">
                <div class="h3 mb-0 fw-bold">{{ total }}</div>
                <div class="text-muted small">Cultures (filtrées)</div>
            </div>
        </div>
        <!-- Stat: Cultures matures -->
        <div class="col-md-4">
            <div class="p-3 bg-light rounded text-center" style="border-left: 4px solid #dc3545;">
                <div class="h3 mb-0 fw-bold text-danger">{{ counts.maturite ?? 0 }}</div>
                <div class="text-muted small">À Récolter (Matures)</div>
            </div>
        </div>
        <!-- Stat: Alertes -->
        <div class="col-md-4">
            <div class="p-3 bg-light rounded text-center" style="border-left: 4px solid #ffc107;">
                <div class="h3 mb-0 fw-bold text-warning">{{ alerts is defined ? (alerts|length) : 0 }}</div>
                <div class="text-muted small">Alertes Récoltes Imminentes</div>
            </div>
        </div>
    </div>

    <div class="small text-muted mb-2">Répartition des états</div>



    <div class="agri-progress mt-3" aria-hidden="true" title="Répartition">
        {% set etats = ['germination','croissance','floraison','maturite'] %}
        {% for e in etats %}
            {% set count = counts[e] ?? 0 %}
            {% set percent = (total > 0 ? ((count / total) * 100) : 0) %}
            <div class="agri-progress__seg agri-progress__seg--{{ e }}" style="width: {{ percent }}%"></div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-end flex-wrap gap-2 mt-2">
        <span class="badge text-bg-dark">Affichés: {{ total }}</span>
        <span class="badge text-bg-warning">Alertes: {{ alerts is defined ? (alerts|length) : 0 }}</span>
        <span class="badge" style="background:#6f42c1;">Germination: {{ counts.germination ?? 0 }}</span>
        <span class="badge text-bg-success">Croissance: {{ counts.croissance ?? 0 }}</span>
        <span class="badge text-bg-warning">Floraison: {{ counts.floraison ?? 0 }}</span>
        <span class="badge text-bg-danger">Mature: {{ counts.maturite ?? 0 }}</span>
    </div>
</div>

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted small">
            {{ cultures|length }} résultat(s)
            {% if q %}pour "{{ q }}"{% endif %}
        </div>
    </div>

    <div class="row g-3">
        {% for c in cultures %}
            {% set etatLabel = {
                'germination': 'Germination',
                'croissance': 'Croissance',
                'floraison': 'Floraison',
                'maturite': 'Mature'
            }[c.etat_croissance] ?? c.etat_croissance %}

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm h-100 agri-culture-card"
                     role="button"
                     tabindex="0"
                     data-id="{{ c.id_culture }}"
                     data-href="{{ path('agri_culture_show', {id: c.id_culture}) }}"
                     data-delete-token="{{ csrf_token('delete_culture_' ~ c.id_culture) }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <div class="text-muted small">Culture</div>
                                <div class="h5 mb-1">
                                    <a class="text-decoration-none" href="{{ path('agri_culture_show', {id: c.id_culture}) }}">
                                        {{ c.type_culture }}
                                    </a>
                                </div>
                                <div class="small text-muted">Parcelle: <strong>{{ c.parcelle ? c.parcelle.nom : '-' }}</strong></div>
                            </div>
                            <div>
                                <span class="agri-badge agri-badge--{{ c.etat_croissance }}">{{ etatLabel }}</span>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="d-grid" style="row-gap: .5rem;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Plantation</span>
                                <strong>{{ c.date_plantation ? c.date_plantation|date('Y-m-d') : '-' }}</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Récolte prévue</span>
                                <strong>{{ c.date_recolte_prevue ? c.date_recolte_prevue|date('Y-m-d') : '-' }}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <div class="d-flex justify-content-end">
                            <span class="text-muted small">Double-clic : détails</span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center text-muted py-4">Aucune culture</div>
            </div>
        {% endfor %}
    </div>
</div>

