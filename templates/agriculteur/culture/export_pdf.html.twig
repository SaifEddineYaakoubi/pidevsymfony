<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Export Cultures</title>
    <style>
        body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 12px; color: #1f2937; }
        h1 { font-size: 18px; margin: 0 0 12px; }
        .meta { font-size: 11px; color: #555; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        th { background: #1b7f3a; color: #fff; text-align: left; }
        .badge { font-weight: bold; }
    </style>
</head>
<body>
<h1>Liste des cultures</h1>
<div class="meta">
    Exporté le {{ exportedAt|date('d/m/Y H:i') }}
    {% if q %} — Recherche: "{{ q }}"{% endif %}
</div>

<table>
    <thead>
    <tr>
        <th>Parcelle</th>
        <th>Type</th>
        <th>Plantation</th>
        <th>Récolte prévue</th>
        <th>État</th>
    </tr>
    </thead>
    <tbody>
    {% for c in cultures %}
        <tr>
            <td>{{ c.parcelle ? c.parcelle.nom : '-' }}</td>
            <td>{{ c.typeCulture ?? c.type_culture }}</td>
            <td>{{ c.datePlantation ? c.datePlantation|date('d/m/Y') : '-' }}</td>
            <td>{{ c.dateRecoltePrevue ? c.dateRecoltePrevue|date('d/m/Y') : '-' }}</td>
            <td class="badge">
                {% set etatLabel = {
                    'germination': 'Germination',
                    'croissance': 'Croissance',
                    'floraison': 'Floraison',
                    'maturite': 'Mature'
                }[c.etatCroissance ?? c.etat_croissance] ?? (c.etatCroissance ?? c.etat_croissance) %}
                {{ etatLabel }}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5">Aucune culture</td></tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>

