{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Ajouter culture' : 'Modifier culture' }}{% endblock %}

{% block agriculteur_body %}
    {% include 'front/partials/_page_title.html.twig' with {
        title: (mode == 'new' ? 'Ajouter culture' : 'Modifier culture'),
        breadcrumbs: [
            { label: 'Home', route: 'app_agriculteur_home' },
            { label: 'Cultures', route: 'agri_culture_index' },
            { label: (mode == 'new' ? 'Ajouter' : 'Modifier') }
        ]
    } %}

<section class="section">
<div class="container">

    {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-turbo': 'false' } }) }}

    {% if extraErrors is defined and extraErrors['_global'] is defined %}
        <div class="alert alert-danger">{{ extraErrors['_global'] }}</div>
    {% endif %}

    <div class="row g-3">
        <div class="col-md-6">
            {{ form_label(form.parcelle) }}
            {{ form_widget(form.parcelle, {attr: {class: 'form-select'}}) }}
            <div class="text-danger small">{{ form_errors(form.parcelle) }}</div>
            {% if extraErrors.parcelle is defined %}<div class="text-danger small">{{ extraErrors.parcelle }}</div>{% endif %}
        </div>

        <div class="col-md-6">
            {{ form_label(form.typeCulture) }}
            {{ form_widget(form.typeCulture, {attr: {class: 'form-select'}}) }}
            <div class="text-danger small">{{ form_errors(form.typeCulture) }}</div>
            {% if extraErrors.type_culture is defined %}<div class="text-danger small">{{ extraErrors.type_culture }}</div>{% endif %}
        </div>

        <div class="col-md-6">
            {{ form_label(form.datePlantation) }}
            {{ form_widget(form.datePlantation, {attr: {class: 'form-control'}}) }}
            <div class="text-danger small">{{ form_errors(form.datePlantation) }}</div>
            {% if extraErrors.date_plantation is defined %}<div class="text-danger small">{{ extraErrors.date_plantation }}</div>{% endif %}
        </div>

        <div class="col-md-6">
            {{ form_label(form.dateRecoltePrevue) }}
            {{ form_widget(form.dateRecoltePrevue, {attr: {class: 'form-control'}}) }}
            <div class="text-danger small">{{ form_errors(form.dateRecoltePrevue) }}</div>
            {% if extraErrors.date_recolte_prevue is defined %}<div class="text-danger small">{{ extraErrors.date_recolte_prevue }}</div>{% endif %}
        </div>



        <div class="col-12 d-flex gap-2">
            <button class="btn btn-success" type="submit">Enregistrer</button>
            <a class="btn btn-secondary" href="{{ path('agri_culture_index') }}">Retour</a>
        </div>
    </div>

    {{ form_end(form) }}
</div>
</section>

<script>
    (function() {
        // Obtenir les identifiants générés par Symfony
        const typeSelect = document.getElementById('{{ form.typeCulture.vars.id }}');
        const plantationInput = document.getElementById('{{ form.datePlantation.vars.id }}');
        const recolteInput = document.getElementById('{{ form.dateRecoltePrevue.vars.id }}');

        function updateRecolteDate() {
            if (!typeSelect || !plantationInput || !recolteInput) return;

            const selectedOption = typeSelect.options[typeSelect.selectedIndex];
            if (!selectedOption) return;
            
            const duration = parseInt(selectedOption.getAttribute('data-duration') || 0, 10);
            const plantationDateStr = plantationInput.value;

            if (duration > 0 && plantationDateStr) {
                const plantationDate = new Date(plantationDateStr);
                plantationDate.setDate(plantationDate.getDate() + duration);
                
                // Formatage YYYY-MM-DD pour le champ de type date
                const yyyy = plantationDate.getFullYear();
                const mm = String(plantationDate.getMonth() + 1).padStart(2, '0');
                const dd = String(plantationDate.getDate()).padStart(2, '0');
                
                recolteInput.value = `${yyyy}-${mm}-${dd}`;
            }
        }

        if (typeSelect) {
            typeSelect.addEventListener('change', updateRecolteDate);
            // Empêcher l'utilisateur de taper n'importe quoi si c'est un select "transformé"
        }
        if (plantationInput) {
            plantationInput.addEventListener('change', updateRecolteDate);
            // S'assurer que le blur fonctionne aussi pour le datepicker natif
            plantationInput.addEventListener('blur', updateRecolteDate);
        }
    })();
</script>
{% endblock %}

