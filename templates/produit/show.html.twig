{% extends 'front/base_stock.html.twig' %}

{% block title %}Détail du Produit{% endblock %}

{% block agriculteur_body %}
    <div class="container section py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm rounded-4">
                    <div class="card-header" style="background: linear-gradient(135deg, #2E8B57 0%, #32CD32 100%); color: white;">
                        <h3 class="mb-0"><span style="font-size: 1.5em; margin-right: 10px;">{{ produit.icon }}</span>{{ produit.nom }}</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Icône</dt>
                            <dd class="col-sm-8"><span style="font-size: 3em;">{{ produit.icon }}</span></dd>

                            <dt class="col-sm-4 text-muted">ID produit</dt>
                            <dd class="col-sm-8">{{ produit.idProduit }}</dd>

                            <dt class="col-sm-4 text-muted">Type</dt>
                            <dd class="col-sm-8">{{ produit.type }}</dd>

                            <dt class="col-sm-4 text-muted">Unité</dt>
                            <dd class="col-sm-8">{{ produit.unite }}</dd>

                            <dt class="col-sm-4 text-muted">Prix unitaire</dt>
                            <dd class="col-sm-8">{{ produit.prixUnitaire }} DT</dd>
                        </dl>

                        <div class="mt-4 d-flex justify-content-between">
                            <a href="{{ path('produit_index') }}" class="btn" style="background-color: #DEB887; color: #8B4513; border: none;">Retour</a>
                            <a href="{{ path('produit_edit', {'id_produit': produit.idProduit}) }}" class="btn" style="background: linear-gradient(135deg, #FFA500 0%, #FFD700 100%); color: white; border: none;">Modifier</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
