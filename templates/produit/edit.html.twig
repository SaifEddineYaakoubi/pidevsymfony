{% extends 'front/base_stock.html.twig' %}

{% block title %}Modifier le Produit{% endblock %}

{% block agriculteur_body %}
    <div class="container section py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm rounded-4 border-0 overflow-hidden">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #D4A574 0%, #C19A6B 100%);">
                        <h3 class="mb-0 text-white fw-bold"><span style="font-size: 1.5em; margin-right: 10px;">{{ form.vars.data.icon }}</span><i class="bi bi-pencil-square me-2"></i>Modifier le Produit</h3>
                    </div>
                    <div class="card-body p-5">
                        {{ form_start(form, {'attr': {'class': 'form-validation', 'data-turbo': 'false'}}) }}

                        <div class="row g-4">
                            <div class="col-md-6">
                                {{ form_label(form.nom, 'Nom du produit', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.nom, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': 'Ex: Tomate rouge', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.nom) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.type, 'Type/Catégorie', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.type, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': 'Ex: Légume, Fruit', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.type) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.unite, 'Unité de mesure', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.unite, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': 'Ex: kg, l, pièce', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.unite) }}</small>
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.prix_unitaire, 'Prix unitaire (DT)', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.prix_unitaire, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': '0.00', 'required': 'required'}}) }}
                                <small class="form-text text-muted">{{ form_help(form.prix_unitaire) }}</small>
                            </div>
                        </div>

                        <div class="mt-5 d-flex justify-content-between gap-3">
                            <a href="{{ path('produit_index') }}" class="btn btn-lg rounded-3" style="background-color: #D4A574; color: white; border: none; font-weight: 500;">
                                <i class="bi bi-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-lg rounded-3 shadow-sm" style="background: linear-gradient(135deg, #2E8B57 0%, #3CAA6F 100%); color: white; border: none; font-weight: 500;">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer les modifications
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
