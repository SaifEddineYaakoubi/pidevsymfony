<form method="post" action="{{ path('produit_delete', {'id_produit': produit.id_produit}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id_produit) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
