{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Détail de la Récolte #{{ recolte.id_recolte }}{% endblock %}

{% block agriculteur_body %}

<h1>👁️ Détail de la Récolte #{{ recolte.id_recolte }}</h1>

<table class="table">
    <tbody>
        <tr>
            <th>ID Récolte</th>
            <td>{{ recolte.id_recolte }}</td>
        </tr>
        <tr>
            <th>Quantité</th>
            <td>{{ recolte.quantite }} kg</td>
        </tr>
        <tr>
            <th>Date de Récolte</th>
            <td>{{ recolte.date_recolte ? recolte.date_recolte|date('d/m/Y') : 'Non définie' }}</td>
        </tr>
        <tr>
            <th>Qualité</th>
            <td>{{ recolte.qualite }}</td>
        </tr>
        <tr>
            <th>Type de Culture</th>
            <td>{{ recolte.type_culture }}</td>
        </tr>
        <tr>
            <th>Localisation</th>
            <td>{{ recolte.localisation }}</td>
        </tr>
        <tr>
            <th>Agriculteur (ID)</th>
            <td>#{{ recolte.id_user }}</td>
        </tr>
        <tr>
            <th>Rendement (Productivité)</th>
            <td>
                {% if rendement %}
                    {{ rendement.productivite|number_format(2, '.', '') }} kg/m²
                {% else %}
                    Non calculé
                {% endif %}
            </td>
        </tr>
    </tbody>
</table>

<div style="margin-top: 2rem;">
    <a href="{{ path('app_recolte_index') }}" class="btn" style="background: #2D5016;">← Retour à la liste</a>
    <a href="{{ path('app_recolte_edit', {'id_recolte': recolte.id_recolte}) }}" class="btn" style="background: #8B6F47;">Modifier</a>
    <a href="{{ path('app_rendement_new') }}" class="btn" style="background: #4A7C2F;">📊 Calculer Rendement</a>
    <a href="{{ path('app_recolte_delete_confirm', {'id_recolte': recolte.id_recolte}) }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette récolte ? Vous devrez indiquer une cause.');">Supprimer</a>
</div>

{% endblock %}
