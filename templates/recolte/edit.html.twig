{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Modifier une Récolte{% endblock %}

{% block agriculteur_body %}

<h1>✏️ Modifier la Récolte #{{ recolte.id_recolte }}</h1>

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    <div class="form-group">
        <label>Quantité (kg) *</label>
        {{ form_widget(form.quantite, {'attr': {'class': 'form-control'}}) }}
        {% if form.quantite.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-1">
                {{ form_errors(form.quantite) }}
            </div>
        {% endif %}
    </div>

    <div class="form-group">
        <label>Date de Récolte *</label>
        {{ form_widget(form.date_recolte, {'attr': {'class': 'form-control', 'max': 'today', 'type': 'date'}}) }}
        {% if form.date_recolte.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-1">
                {{ form_errors(form.date_recolte) }}
            </div>
        {% endif %}
        <small class="text-muted d-block mt-1">
            <i class="fas fa-info-circle"></i> La date ne peut pas être dans le futur
        </small>
    </div>

    <div class="form-group">
        <label>Qualité *</label>
        {{ form_widget(form.qualite, {'attr': {'class': 'form-control'}}) }}
        {% if form.qualite.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-1">
                {{ form_errors(form.qualite) }}
            </div>
        {% endif %}
    </div>

    <div class="form-group">
        <label>Type de Culture *</label>
        {{ form_widget(form.type_culture, {'attr': {'class': 'form-control'}}) }}
        {% if form.type_culture.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-1">
                {{ form_errors(form.type_culture) }}
            </div>
        {% endif %}
    </div>

    <div class="form-group">
        <label>Localisation *</label>
        {{ form_widget(form.localisation, {'attr': {'class': 'form-control'}}) }}
        {% if form.localisation.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-1">
                {{ form_errors(form.localisation) }}
            </div>
        {% endif %}
    </div>

    <div style="margin-top: 2rem;">
        <button type="submit" class="btn" style="background: #4A7C2F;">Enregistrer les modifications</button>
        <a href="{{ path('app_recolte_index') }}" class="btn btn-secondary">Annuler</a>
    </div>

{{ form_end(form) }}

<div style="margin-top: 3rem; padding: 1rem; background: #fee; border: 1px solid #fcc;">
    <h3>⚠️ Zone Danger</h3>
    <p>Pour supprimer cette récolte, vous devrez indiquer une cause de suppression.</p>
    <a href="{{ path('app_recolte_delete_confirm', {'id_recolte': recolte.id_recolte}) }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette récolte ? Vous devrez indiquer une cause.');">
        🗑 Supprimer cette Récolte
    </a>
</div>

{% endblock %}
