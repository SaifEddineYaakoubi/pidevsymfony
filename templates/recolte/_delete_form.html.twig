<form method="post" action="{{ path('app_recolte_delete', {'id_recolte': recolte.id_recolte}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recolte.id_recolte) }}">
    <button class="btn">Delete</button>
</form>
