{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Récoltes - AgriCulture{% endblock %}

{% block agriculteur_body %}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'Récoltes',
        breadcrumbs: [
            { label: 'Home', route: 'app_agriculteur_home' },
            { label: 'Récoltes' }
        ]
    } %}

    <section class="section">
        <div class="container">

            <div class="agri-crud">

                {% for label, messages in app.flashes %}
                    {% for msg in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ msg }}</div>
                    {% endfor %}
                {% endfor %}

                <div class="crud-header mb-4"
                     data-controller="crud-search"
                     data-crud-search-url-value="{{ path('app_recolte_index') }}">
                    <div class="row g-3 align-items-center">
                        <div class="col-lg-8">
                            <form class="d-flex gap-2" method="get">
                                <input class="form-control"
                                       name="search"
                                       value="{{ search }}"
                                       placeholder="Rechercher (type, localisation)"
                                       autocomplete="off"
                                       data-crud-search-target="input"
                                       data-action="input->crud-search#search">
                                <input type="hidden" name="sort" value="{{ sort|default('date_desc') }}">

                                {% if search %}
                                    <a class="btn btn-outline-secondary" href="{{ path('app_recolte_index', {sort: sort|default('date_desc')}) }}">Effacer</a>
                                {% endif %}
                            </form>
                        </div>

                        <div class="col-lg-4 text-lg-end d-flex gap-2 justify-content-lg-end flex-wrap">
                            <a class="btn btn-outline-secondary" href="{{ path('app_rendement_index') }}">Rendements</a>
                            <a class="btn btn-outline-secondary" href="{{ path('app_archive_index') }}">Archives</a>
                            <a class="btn btn-outline-secondary" href="{{ path('app_recolte_statistiques') }}">Statistiques</a>
                            <a class="btn btn-success" href="{{ path('app_recolte_new') }}">Ajouter</a>
                            <a id="btnEdit" class="btn btn-outline-primary disabled" href="#">Modifier</a>
                            <form id="deleteForm" method="post" class="m-0">
                                <input type="hidden" name="_token" id="deleteToken" value="">
                                <button id="btnDelete" class="btn btn-outline-danger" type="submit" disabled>Supprimer</button>
                            </form>
                        </div>
                    </div>

                    <div class="mt-3 d-flex flex-wrap justify-content-end align-items-center gap-2">
                        <label class="small text-muted align-self-center">Trier par</label>
                        <select class="form-select form-select-sm"
                                name="sort"
                                data-crud-search-target="sort"
                                data-action="change->crud-search#sortChanged">
                            <option value="date_desc" {{ (sort|default('date_desc')) == 'date_desc' ? 'selected' : '' }}>Date (récent)</option>
                            <option value="date_asc" {{ (sort|default('date_desc')) == 'date_asc' ? 'selected' : '' }}>Date (ancien)</option>
                            <option value="type_asc" {{ (sort|default('date_desc')) == 'type_asc' ? 'selected' : '' }}>Type (A→Z)</option>
                            <option value="type_desc" {{ (sort|default('date_desc')) == 'type_desc' ? 'selected' : '' }}>Type (Z→A)</option>
                        </select>
                    </div>

                    {# results area below #}
                </div>

                <div class="agri-crud-results" data-crud-search-target="results">
                    <div class="agri-crud-loader" aria-hidden="true"></div>

                    {# Render the list itself (also returned for AJAX) #}
                    {% include 'recolte/_results.html.twig' %}
                </div>

            </div>
        </div>
    </section>

    <script>
        (function() {
            const btnEdit = document.getElementById('btnEdit');
            const btnDelete = document.getElementById('btnDelete');
            const deleteForm = document.getElementById('deleteForm');
            const deleteToken = document.getElementById('deleteToken');
            const results = document.querySelector('[data-crud-search-target="results"]');

            function clearSelection() {
                const table = document.getElementById('recolteTable');
                if (!table) return;
                table.querySelectorAll('tbody tr').forEach(tr => tr.classList.remove('is-selected'));
            }

            function setSelected(row) {
                clearSelection();
                row.classList.add('is-selected');
                const selectedId = row.dataset.id;
                if (!selectedId) return;

                btnEdit.classList.remove('disabled');
                btnEdit.href = '{{ path('app_recolte_edit', {'id_recolte': 0}) }}'.replace('/0/edit', '/' + selectedId + '/edit');

                btnDelete.disabled = false;
                deleteForm.action = '{{ path('app_recolte_delete', {'id_recolte': 0}) }}'.replace('/0', '/' + selectedId);
                deleteToken.value = row.dataset.deleteToken || '';
            }

            if (results) {
                results.addEventListener('click', (e) => {
                    const row = e.target.closest('tr[data-id]');
                    if (!row) return;
                    setSelected(row);
                });

                results.addEventListener('dblclick', (e) => {
                    const row = e.target.closest('tr[data-id][data-href]');
                    if (!row) return;
                    const href = row.dataset.href;
                    if (href) window.location.href = href;
                });
            }

            document.addEventListener('crud:results-updated', () => {
                btnEdit.classList.add('disabled');
                btnEdit.href = '#';
                btnDelete.disabled = true;
                deleteToken.value = '';
                deleteForm.action = '';
            });
        })();
    </script>

    {# Fallback: if Stimulus is not running for some reason, still do live search #}
    <script>
        (function() {
            const wrapper = document.querySelector('[data-controller="crud-search"]');
            const input = document.querySelector('[data-crud-search-target="input"]');
            const sort = document.querySelector('[data-crud-search-target="sort"]');
            const results = document.querySelector('[data-crud-search-target="results"]');
            if (!wrapper || !input || !results) return;

            let timer = null;
            async function doSearch() {
                const q = input.value || '';
                const url = new URL(wrapper.getAttribute('data-crud-search-url-value'), window.location.origin);
                url.searchParams.set('search', q);
                if (sort) url.searchParams.set('sort', sort.value);

                const loader = results.querySelector('.agri-crud-loader');
                results.classList.add('is-loading');
                try {
                    const res = await fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) return;
                    results.innerHTML = await res.text();
                    if (loader) results.prepend(loader);
                    document.dispatchEvent(new CustomEvent('crud:results-updated'));
                } catch (e) {
                    // ignore network errors
                } finally {
                    results.classList.remove('is-loading');
                }
            }

            input.addEventListener('input', () => {
                window.clearTimeout(timer);
                timer = window.setTimeout(doSearch, 250);
            });
            if (sort) sort.addEventListener('change', doSearch);
        })();
    </script>
{% endblock %}
