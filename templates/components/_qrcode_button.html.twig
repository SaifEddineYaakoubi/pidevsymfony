{# templates/components/_qrcode_button.html.twig #}
{# 
    Bouton réutilisable pour générer un QR Code
    
    Paramètres:
    - type: 'vente' ou 'client'
    - id: ID de l'entité
    - label: Label à afficher dans le modal
    - btn_class: Classes CSS du bouton (optionnel)
    - btn_text: Texte du bouton (optionnel)
    - icon_only: Afficher uniquement l'icône (optionnel, défaut: false)
#}

{% set btn_class = btn_class|default('btn btn-info btn-sm') %}
{% set btn_text = btn_text|default('QR Code') %}
{% set icon_only = icon_only|default(false) %}

{% if type == 'vente' %}
    {% set url = path('app_vente_qrcode', {'idVente': id}) %}
{% elseif type == 'client' %}
    {% set url = path('app_client_qrcode', {'id_client': id}) %}
{% endif %}

<button 
    type="button" 
    class="{{ btn_class }}" 
    onclick="openQrCodeModal('{{ url }}', '{{ type }}', {{ id }}, '{{ label|e('js') }}')"
    title="Générer le QR Code"
>
    <i class="fas fa-qrcode"></i>
    {% if not icon_only %}
        {{ btn_text }}
    {% endif %}
</button>
