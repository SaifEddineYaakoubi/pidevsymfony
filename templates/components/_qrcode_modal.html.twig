{# templates/components/_qrcode_modal.html.twig #}
{# Modal réutilisable pour afficher les QR Codes #}

<!-- QR Code Modal -->
<div id="qrcodeModal" class="qrcode-modal" style="display: none;">
    <div class="qrcode-modal-overlay" onclick="closeQrCodeModal()"></div>
    <div class="qrcode-modal-content">
        <div class="qrcode-modal-header">
            <h3 id="qrcodeModalTitle">QR Code</h3>
            <button class="qrcode-modal-close" onclick="closeQrCodeModal()" aria-label="Fermer">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div class="qrcode-modal-body">
            <div id="qrcodeLoader" class="qrcode-loader">
                <div class="spinner"></div>
                <p>Génération du QR Code...</p>
            </div>
            
            <div id="qrcodeContent" class="qrcode-content" style="display: none;">
                <div class="qrcode-image-container">
                    <img id="qrcodeImage" src="" alt="QR Code" class="qrcode-image">
                </div>
                
                <div class="qrcode-info">
                    <p id="qrcodeDescription" class="text-muted"></p>
                </div>
            </div>
            
            <div id="qrcodeError" class="qrcode-error" style="display: none;">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Erreur lors de la génération du QR Code</p>
            </div>
        </div>
        
        <div class="qrcode-modal-footer">
            <button class="btn btn-secondary" onclick="closeQrCodeModal()">
                <i class="fas fa-times"></i> Fermer
            </button>
            <a id="qrcodeDownloadBtn" href="#" class="btn btn-primary" download style="display: none;">
                <i class="fas fa-download"></i> Télécharger
            </a>
        </div>
    </div>
</div>

<style>
/* QR Code Modal Styles */
.qrcode-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
}

.qrcode-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
}

.qrcode-modal-content {
    position: relative;
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow: hidden;
    animation: slideUp 0.3s ease;
}

.qrcode-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid #e9ecef;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.qrcode-modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
}

.qrcode-modal-close {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.qrcode-modal-close:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(90deg);
}

.qrcode-modal-body {
    padding: 32px 24px;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.qrcode-loader {
    text-align: center;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.qrcode-content {
    width: 100%;
    text-align: center;
}

.qrcode-image-container {
    background: #f8f9fa;
    padding: 24px;
    border-radius: 12px;
    display: inline-block;
    margin-bottom: 16px;
}

.qrcode-image {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
}

.qrcode-info {
    margin-top: 16px;
}

.qrcode-error {
    text-align: center;
    color: #dc3545;
}

.qrcode-error i {
    font-size: 3rem;
    margin-bottom: 16px;
}

.qrcode-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 24px;
    border-top: 1px solid #e9ecef;
    background: #f8f9fa;
}

.qrcode-modal-footer .btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.qrcode-modal-footer .btn-secondary {
    background: #6c757d;
    color: white;
}

.qrcode-modal-footer .btn-secondary:hover {
    background: #5a6268;
}

.qrcode-modal-footer .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.qrcode-modal-footer .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes slideUp {
    from {
        transform: translateY(50px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

/* Responsive */
@media (max-width: 576px) {
    .qrcode-modal-content {
        width: 95%;
        max-width: none;
    }
    
    .qrcode-modal-header,
    .qrcode-modal-body,
    .qrcode-modal-footer {
        padding: 16px;
    }
}
</style>

<script>
// Fonctions JavaScript pour gérer le modal QR Code
function openQrCodeModal(url, type, id, label) {
    const modal = document.getElementById('qrcodeModal');
    const loader = document.getElementById('qrcodeLoader');
    const content = document.getElementById('qrcodeContent');
    const error = document.getElementById('qrcodeError');
    const title = document.getElementById('qrcodeModalTitle');
    const image = document.getElementById('qrcodeImage');
    const description = document.getElementById('qrcodeDescription');
    const downloadBtn = document.getElementById('qrcodeDownloadBtn');
    
    // Afficher le modal
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Réinitialiser l'état
    loader.style.display = 'block';
    content.style.display = 'none';
    error.style.display = 'none';
    downloadBtn.style.display = 'none';
    
    // Mettre à jour le titre
    title.textContent = `QR Code - ${label}`;
    
    // Charger le QR code via AJAX
    fetch(url)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Afficher le QR code
                image.src = 'data:image/png;base64,' + data.qrcode;
                description.textContent = `Scannez ce QR code pour accéder aux informations de ${label}`;
                
                // Configurer le bouton de téléchargement
                const downloadUrl = url.replace('/qrcode', '/qrcode/download');
                downloadBtn.href = downloadUrl;
                downloadBtn.style.display = 'inline-flex';
                
                // Afficher le contenu
                loader.style.display = 'none';
                content.style.display = 'block';
            } else {
                throw new Error('Erreur lors de la génération du QR code');
            }
        })
        .catch(err => {
            console.error('Erreur:', err);
            loader.style.display = 'none';
            error.style.display = 'block';
        });
}

function closeQrCodeModal() {
    const modal = document.getElementById('qrcodeModal');
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
}

// Fermer le modal avec la touche Échap
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeQrCodeModal();
    }
});
</script>
