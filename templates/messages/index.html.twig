{% set base_layout = is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : (is_granted('ROLE_STOCK') ? 'front/base_stock.html.twig' : 'front/base_agriculteur.html.twig') %}
{% extends base_layout %}

{% block title %}Messages - SmartFarm{% endblock %}

{# On définit les deux blocs possibles pour la compatibilité entre thèmes #}
{% block javascripts %}
    {{ parent() }}
    {# On s'assure d'avoir jQuery et FontAwesome sur toutes les interfaces #}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
{% endblock %}

{% block admin_page_title %}Ma Messagerie{% endblock %}
{% block admin_body %}
    {{ block('messaging_content') }}
{% endblock %}

{% block agriculteur_body %}
    <div class="container-fluid py-4">
        {{ block('messaging_content') }}
    </div>
{% endblock %}

{% block messaging_content %}
<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline shadow-sm">
            <div class="card-header border-0 bg-white py-3">
                <h3 class="card-title font-weight-bold">Mes Discussions</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-toggle="modal" data-target="#newUserModal" data-bs-toggle="modal" data-bs-target="#newUserModal">
                        <i class="fas fa-plus mr-1"></i> Nouvelle Discussion
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive mailbox-messages">
                    <table class="table table-hover table-striped mb-0">
                        <tbody>
                            {% if conversations is empty %}
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="far fa-comments fa-3x mb-3 text-light"></i><br>
                                            Aucune discussion pour le moment.
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                {% for conv in conversations %}
                                    {% set partner_url = path('app_messages_chat', {id: conv.partner.idUser}) %}
                                    <tr onclick="window.location.href='{{ partner_url }}'" style="cursor: pointer;">
                                        <td class="mailbox-star" style="width: 60px;">
                                            <div class="user-avatar bg-{{ conv.partner.role == 'admin' ? 'danger' : (conv.partner.role == 'responsable_stock' ? 'warning' : 'success') }}">
                                                {{ conv.partner.prenom|first|upper }}
                                            </div>
                                        </td>
                                        <td class="mailbox-name py-3">
                                            <a href="{{ partner_url }}" class="font-weight-bold text-dark">
                                                {{ conv.partner.prenom }} {{ conv.partner.nom }}
                                            </a>
                                            {% if not conv.isRead and not conv.isMe %}
                                                <span class="badge badge-primary ml-2">Nouveau</span>
                                            {% endif %}
                                        </td>
                                        <td class="mailbox-subject text-truncate" style="max-width: 300px;">
                                            <span class="text-muted">
                                                {% if conv.isMe %}<i class="fas fa-reply small mr-1"></i> Vous : {% endif %}
                                                {{ conv.lastMessage|slice(0, 50) }}{{ conv.lastMessage|length > 50 ? '...' : '' }}
                                            </span>
                                        </td>
                                        <td class="mailbox-date text-right text-muted">{{ conv.sentAt|date('d/m H:i') }}</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nouveaux Utilisateurs -->
<div class="modal fade" id="newUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Démarrer une conversation</h5>
                <button type="button" class="btn-close text-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
            </div>
            <div class="modal-body p-0">
                <div class="list-group list-group-flush">
                    {% for user in allUsers %}
                        <a href="{{ path('app_messages_chat', {id: user.idUser}) }}" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                            <div class="user-avatar bg-secondary mr-3" style="width: 35px; height: 35px; font-size: 0.8rem;">
                                {{ user.prenom|first|upper }}
                            </div>
                            <div>
                                <h6 class="mb-0 font-weight-bold">{{ user.prenom }} {{ user.nom }}</h6>
                                <small class="text-muted">{{ user.role|replace({'_': ' '})|title }}</small>
                            </div>
                            <i class="fas fa-chevron-right ml-auto text-muted small"></i>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: white;
}
</style>
{% endblock %}
