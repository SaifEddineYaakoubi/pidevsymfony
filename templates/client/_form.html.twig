{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="mb-3">
        {{ form_row(form.nom) }}
    </div>

    <div class="mb-3">
        {{ form_row(form.contact) }}
    </div>

    <div class="mb-3">
        {{ form_row(form.adresse) }}
