{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erreurs de validation :</strong>
            {{ form_errors(form) }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="mb-3">
        <label class="form-label">{{ form.nom.vars.label }}</label>
        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        {% if form.nom.vars.errors|length > 0 %}
            <div class="invalid-feedback d-block">
                {{ form_errors(form.nom) }}
            </div>
        {% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label">{{ form.contact.vars.label }}</label>
        {{ form_widget(form.contact, {'attr': {'class': 'form-control', 'placeholder': 'Optionnel (min 5 caractères)'}}) }}
        {% if form.contact.vars.errors|length > 0 %}
            <div class="invalid-feedback d-block">
                {{ form_errors(form.contact) }}
            </div>
        {% endif %}
        <small class="form-text text-muted">Optionnel</small>
    </div>

    <div class="mb-3">
        <label class="form-label">{{ form.adresse.vars.label }}</label>
        {{ form_widget(form.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Optionnel (min 3 caractères)'}}) }}
        {% if form.adresse.vars.errors|length > 0 %}
            <div class="invalid-feedback d-block">
                {{ form_errors(form.adresse) }}
            </div>
        {% endif %}
        <small class="form-text text-muted">Optionnel</small>
    </div>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> {{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_client_index') }}" class="btn btn-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}
