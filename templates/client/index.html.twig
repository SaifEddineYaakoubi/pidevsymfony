{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Clients - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div style="background-color: #f8f9fa; min-height: 100vh; padding: 20px 0;">
        <div style="max-width: 1200px; margin: 0 auto; padding: 20px;">

            <!-- Header Section -->
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h1 style="margin: 0 0 5px 0; font-weight: 700; color: #1a1a2e; font-size: 1.75rem;">👥 Clients</h1>
                        <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">Gérez vos clients</p>
                    </div>
                    <div style="background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%); color: #667eea; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">
                        <i class="fas fa-users" style="margin-right: 6px;"></i>{{ clients|length }}
                    </div>
                </div>
            </div>

            <!-- Search Card -->
            <div style="background: white; border-radius: 10px; padding: 16px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);">
                <form method="GET" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 250px;">
                        <div style="display: flex; align-items: center; border: 1px solid #e9ecef; border-radius: 8px; background: #f9fafb;">
                            <i class="fas fa-search" style="padding: 8px 12px; color: #9ca3af;"></i>
                            <input
                                type="text"
                                name="search"
                                style="flex: 1; border: none; background: none; padding: 8px 12px; font-size: 0.9rem; outline: none;"
                                placeholder="Rechercher..."
                                value="{{ search }}"
                            >
                        </div>
                    </div>
                    <button type="submit" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 8px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.9rem; white-space: nowrap;">
                        <i class="fas fa-search" style="margin-right: 6px;"></i> Chercher
                    </button>
                    {% if search %}
                        <a href="{{ path('app_client_index') }}" style="background: #f3f4f6; color: #6b7280; border: none; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.9rem; cursor: pointer;">
                            <i class="fas fa-times" style="margin-right: 4px;"></i> Réinitialiser
                        </a>
                    {% endif %}
                </form>
            </div>

            <!-- Table Card -->
            <div style="background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); margin-bottom: 20px;">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                        <thead style="background: linear-gradient(135deg, #2d3561 0%, #1a1f4b 100%); color: white;">
                            <tr>
                                <th style="width: 35%; font-weight: 600; padding: 12px 16px; text-align: left; letter-spacing: 0.3px;">
                                    <a href="{{ path('app_client_index', {
                                        'search': search,
                                        'sortBy': 'nom',
                                        'order': (sortBy == 'nom' ? nextOrder : 'ASC')
                                    }) }}" style="color: white; text-decoration: none; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                                        <span><i class="fas fa-user" style="margin-right: 6px;"></i>Nom</span>
                                        {% if sortBy == 'nom' %}
                                            <i class="fas fa-{{ order == 'ASC' ? 'sort-alpha-down' : 'sort-alpha-up' }}"></i>
                                        {% else %}
                                            <i class="fas fa-sort" style="opacity: 0.5;"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th style="width: 25%; font-weight: 600; padding: 12px 16px; text-align: left; letter-spacing: 0.3px;">
                                    <a href="{{ path('app_client_index', {
                                        'search': search,
                                        'sortBy': 'contact',
                                        'order': (sortBy == 'contact' ? nextOrder : 'ASC')
                                    }) }}" style="color: white; text-decoration: none; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                                        <span><i class="fas fa-phone" style="margin-right: 6px;"></i>Contact</span>
                                        {% if sortBy == 'contact' %}
                                            <i class="fas fa-{{ order == 'ASC' ? 'sort-numeric-down' : 'sort-numeric-up' }}"></i>
                                        {% else %}
                                            <i class="fas fa-sort" style="opacity: 0.5;"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th style="width: 25%; font-weight: 600; padding: 12px 16px; text-align: left; letter-spacing: 0.3px;">
                                    <i class="fas fa-map-marker-alt" style="margin-right: 6px;"></i>Adresse
                                </th>
                                <th style="width: 15%; font-weight: 600; padding: 12px 16px; text-align: center; letter-spacing: 0.3px;">
                                    <i class="fas fa-cog" style="margin-right: 4px;"></i>Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for client in clients %}
                                <tr style="border-bottom: 1px solid #e9ecef; transition: background-color 0.2s;">
                                    <td style="padding: 10px 16px; color: #1a1a2e;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 0.85rem;">
                                                {{ client.nom|first|upper }}
                                            </div>
                                            <span style="font-weight: 500;">{{ client.nom }}</span>
                                        </div>
                                    </td>
                                    <td style="padding: 10px 16px; color: #555;">
                                        <span style="background: #f0f4f9; color: #667eea; padding: 4px 8px; border-radius: 6px; font-size: 0.85rem;">
                                            {{ client.contact ?? 'N/A' }}
                                        </span>
                                    </td>
                                    <td style="padding: 10px 16px; color: #666; font-size: 0.85rem;">
                                        {{ client.adresse ?? '-' }}
                                    </td>
                                    <td style="padding: 10px 16px; text-align: center;">
                                        <div style="display: flex; gap: 4px; justify-content: center;">
                                            <a href="{{ path('app_client_show', {'id_client': client.id_client}) }}" style="background: #f0f4f9; color: #667eea; border: 1px solid #d1d5db; padding: 5px 10px; border-radius: 6px; text-decoration: none; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;" title="Voir">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_client_edit', {'id_client': client.id_client}) }}" style="background: #fef3c7; color: #d97706; border: 1px solid #fbbf24; padding: 5px 10px; border-radius: 6px; text-decoration: none; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;" title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" style="padding: 40px 16px; text-align: center; color: #9ca3af;">
                                        <i class="fas fa-user-slash" style="font-size: 2rem; margin-bottom: 8px; display: block; opacity: 0.3;"></i>
                                        <p style="margin: 8px 0 0 0; font-size: 0.9rem;">Aucun client trouvé</p>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="{{ path('app_client_new') }}" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15); display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-plus"></i> Nouveau
                    </a>
                    <a href="{{ path('app_client_export_pdf', {'search': search, 'sortBy': sortBy, 'order': order}) }}" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 8px rgba(239, 68, 68, 0.15); display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-file-pdf"></i> PDF
                    </a>
                </div>
                <div style="color: #6b7280; font-weight: 500; font-size: 0.9rem;">
                    Total: <strong style="color: #667eea;">{{ clients|length }}</strong>
                </div>
            </div>
        </div>
    </div>
{% endblock %}