{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Clients - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div class="container section">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="mb-4">Gestion des Clients</h1>

                <div class="table-responsive mb-4">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Contact</th>
                                <th>Adresse</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for client in clients %}
                            <tr>
                                <td>{{ client.id_client }}</td>
                                <td>{{ client.nom }}</td>
                                <td>{{ client.contact }}</td>
                                <td>{{ client.adresse }}</td>
                                <td>
                                    <a href="{{ path('app_client_show', {'id_client': client.id_client}) }}" class="btn btn-sm btn-info">Voir</a>
                                    <a href="{{ path('app_client_edit', {'id_client': client.id_client}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">Aucun client enregistré</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <a href="{{ path('app_client_new') }}" class="btn btn-primary">Ajouter un Client</a>
            </div>
        </div>
    </div>
{% endblock %}
