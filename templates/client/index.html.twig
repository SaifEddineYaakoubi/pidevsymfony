{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Clients - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div style="background-color: #f8f9fa; min-height: 100vh; padding: 20px 0;">
        <div style="max-width: 1200px; margin: 0 auto; padding: 20px;">

            <!-- Header Section -->
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h1 style="margin: 0 0 5px 0; font-weight: 700; color: #1a1a2e; font-size: 1.75rem;">👥 Clients</h1>
                        <p style="margin: 0; color: #6b7280; font-size: 0.9rem;">Gérez vos clients</p>
                    </div>
                    <div style="background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%); color: #667eea; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">
                        <i class="fas fa-users" style="margin-right: 6px;"></i>{{ clients|length }}
                    </div>
                </div>
            </div>

            <!-- Search Card -->
            <div style="background: white; border-radius: 10px; padding: 16px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);">
                <form method="GET" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 250px;">
                        <div style="display: flex; align-items: center; border: 1px solid #e9ecef; border-radius: 8px; background: #f9fafb;">
                            <i class="fas fa-search" style="padding: 8px 12px; color: #9ca3af;"></i>
                            <input
                                type="text"
                                name="search"
                                style="flex: 1; border: none; background: none; padding: 8px 12px; font-size: 0.9rem; outline: none;"
                                placeholder="Rechercher..."
                                value="{{ search }}"
                            >
                        </div>
                    </div>
                    <button type="submit" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 8px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.9rem; white-space: nowrap;">
                        <i class="fas fa-search" style="margin-right: 6px;"></i> Chercher
                    </button>
                    {% if search %}
                        <a href="{{ path('app_client_index') }}" style="background: #f3f4f6; color: #6b7280; border: none; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.9rem; cursor: pointer;">
                            <i class="fas fa-times" style="margin-right: 4px;"></i> Réinitialiser
                        </a>
                    {% endif %}
                </form>
            </div>

            {# Dashboard Header Stats #}
            <div class="container" style="padding: 0; margin-bottom: 20px;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 bg-dark text-white h-100">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="small opacity-75">Total Clients</div>
                                        <div class="h5 mb-0">{{ stats.clients_count ?? (clients|length) }}</div>
                                    </div>
                                    <i class="fas fa-users fa-lg opacity-75"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 bg-primary text-white h-100">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="small opacity-75">Dernier Client Inscrit</div>
                                        <div class="h5 mb-0">{% if stats.last_client_id is not empty %}#{{ stats.last_client_id }}{% else %}—{% endif %}</div>
                                    </div>
                                    <i class="fas fa-user-plus fa-lg opacity-75"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom Styles for Cards Grid -->
            <style>
                .client-card {
                    transition: all 0.3s ease;
                    border: 1px solid #e9ecef;
                    height: 100%;
                }
                .client-card:hover {
                    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
                    transform: translateY(-5px);
                }
                .client-card .card-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    border-bottom: none;
                    padding: 16px;
                }
                .client-card .card-header .badge {
                    background: rgba(255, 255, 255, 0.3);
                    color: white;
                    font-size: 0.9rem;
                    padding: 6px 12px;
                }
                .client-card .card-body {
                    padding: 18px 16px;
                }
                .client-card .info-row {
                    display: flex;
                    align-items: flex-start;
                    gap: 12px;
                    margin-bottom: 12px;
                    font-size: 0.9rem;
                }
                .client-card .info-row:last-child {
                    margin-bottom: 0;
                }
                .client-card .info-row i {
                    color: #667eea;
                    min-width: 20px;
                    margin-top: 2px;
                }
                .client-card .info-label {
                    color: #9ca3af;
                    font-weight: 500;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                }
                .client-card .info-value {
                    color: #1a1a2e;
                    font-weight: 500;
                }
                .client-card .card-footer {
                    background: #f9fafb;
                    border-top: 1px solid #e9ecef;
                    padding: 12px 16px;
                    display: flex;
                    gap: 6px;
                    justify-content: center;
                }
                .client-card .btn-group {
                    width: 100%;
                    display: flex;
                    gap: 6px;
                }
                .client-card .btn-group .btn {
                    flex: 1;
                    font-size: 0.8rem;
                    padding: 6px 10px;
                }
                .empty-state {
                    text-align: center;
                    padding: 60px 20px;
                    color: #9ca3af;
                }
                .empty-state i {
                    font-size: 3rem;
                    opacity: 0.2;
                    margin-bottom: 12px;
                    display: block;
                }
            </style>

            <!-- Cards Grid -->
            <div style="margin-bottom: 20px;">
                {% if clients|length > 0 %}
                    <div class="row g-4">
                        {% for client in clients %}
                            <div class="col-lg-4 col-md-6">
                                <div class="card client-card shadow-sm">
                                    <!-- Card Header with Badge -->
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h6 style="margin: 0; color: white; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 28px; height: 28px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem;">
                                                {{ client.nom|first|upper }}
                                            </div>
                                            {{ client.nom|slice(0, 20) }}
                                        </h6>
                                        {# Badge du client #}
                                        {% set badge = client_badge(client) %}
                                        <span class="badge" style="background: rgba(255, 255, 255, 0.3); color: white; font-size: 0.85rem; padding: 6px 10px;" title="{{ client.ventes|length }} vente(s)">
                                            {{ badge.icon }}
                                        </span>
                                    </div>

                                    <!-- Card Body with Information -->
                                    <div class="card-body">
                                        {# Badge détaillé #}
                                        <div class="info-row" style="margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e9ecef;">
                                            <i class="fas fa-medal"></i>
                                            <div style="flex: 1;">
                                                <div class="info-label">Statut Client</div>
                                                <div class="info-value">
                                                    {{ client|badge_html }}
                                                    <span style="color: #9ca3af; font-size: 0.8rem; margin-left: 4px;">
                                                        ({{ client.ventes|length }} vente{{ client.ventes|length > 1 ? 's' : '' }})
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="info-row">
                                            <i class="fas fa-phone"></i>
                                            <div style="flex: 1;">
                                                <div class="info-label">Contact</div>
                                                <div class="info-value">{{ client.contact ?? 'N/A' }}</div>
                                            </div>
                                        </div>
                                        <div class="info-row">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <div style="flex: 1;">
                                                <div class="info-label">Adresse</div>
                                                <div class="info-value" style="font-size: 0.85rem;">{{ client.adresse|slice(0, 35) }}{% if client.adresse|length > 35 %}...{% endif %}</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card Footer with Action Buttons -->
                                    <div class="card-footer">
                                        <div class="btn-group" role="group" aria-label="Actions client">
                                            <a href="{{ path('app_client_show', {'id_client': client.id_client}) }}"
                                               class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center gap-1"
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i><span>Voir</span>
                                            </a>
                                            <a href="{{ path('app_client_edit', {'id_client': client.id_client}) }}"
                                               class="btn btn-outline-warning d-inline-flex align-items-center justify-content-center gap-1"
                                               title="Éditer">
                                                <i class="fas fa-edit"></i><span>Éditer</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="card shadow-sm border-0">
                        <div class="empty-state">
                            <i class="fas fa-user-slash"></i>
                            <p style="margin: 0; font-size: 0.9rem;">Aucun client trouvé</p>
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="{{ path('app_client_new') }}" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15); display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-plus"></i> Nouveau
                    </a>
                    <a href="{{ path('app_client_analysis') }}" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 8px rgba(102, 126, 234, 0.15); display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-chart-pie"></i> Analyse Fidélité
                        <span style="background: rgba(255,255,255,0.3); padding: 2px 6px; border-radius: 4px; font-size: 0.75rem;">NEW</span>
                    </a>
                    <a href="{{ path('app_client_export_pdf', {'search': search, 'sortBy': sortBy, 'order': order}) }}" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 8px rgba(239, 68, 68, 0.15); display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-file-pdf"></i> PDF
                    </a>
                </div>
                <div style="color: #6b7280; font-weight: 500; font-size: 0.9rem;">
                    Total: <strong style="color: #667eea;">{{ clients|length }}</strong>
                </div>
            </div>
        </div>
    </div>
{% endblock %}