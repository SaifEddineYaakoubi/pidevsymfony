{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Détails Client - AgriCulture{% endblock %}

{% block agriculteur_body %}
    <div class="container section">
        <div class="row">
            <div class="col-lg-8">
                <h1 class="mb-4">Détails du Client</h1>

                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th>ID Client</th>
                                    <td>{{ client.id_client }}</td>
                                </tr>
                                <tr>
                                    <th>Nom</th>
                                    <td>{{ client.nom }}</td>
                                </tr>
                                <tr>
                                    <th>Contact</th>
                                    <td>{{ client.contact }}</td>
                                </tr>
                                <tr>
                                    <th>Adresse</th>
                                    <td>{{ client.adresse }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="{{ path('app_client_index') }}" class="btn btn-secondary">Retour à la liste</a>
                    <a href="{{ path('app_client_edit', {'id_client': client.id_client}) }}" class="btn btn-warning">Éditer</a>
                    {{ include('client/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
