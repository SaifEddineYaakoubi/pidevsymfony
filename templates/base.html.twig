<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <title>{% block title %}Smart Farm{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌾</text></svg>">
        {% block stylesheets %}
            {# Bootstrap 5 CSS #}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
            
            {# Styles CSS intégrés pour éviter les problèmes AssetMapper #}
            <style>
                /* Styles AgriCRUD intégrés */
                :root {
                  --agri-green: #1b7f3a;
                  --agri-green-weak: rgba(27, 127, 58, 0.12);
                  --agri-brown: #6b4f2a;
                  --agri-surface: #ffffff;
                  --agri-border: rgba(107, 79, 42, 0.18);
                  --agri-text: #1f2937;
                }

                .agri-crud {
                  color: var(--agri-text);
                }

                .agri-crud .crud-header {
                  background: var(--agri-surface);
                  border: 1px solid var(--agri-border);
                  border-radius: 14px;
                  padding: 14px;
                  box-shadow: 0 8px 26px rgba(0,0,0,0.06);
                  position: relative;
                }

                .agri-crud .crud-header::before {
                  content: "";
                  position: absolute;
                  left: 0;
                  top: 0;
                  right: 0;
                  height: 4px;
                  background: linear-gradient(90deg, var(--agri-green), rgba(27, 127, 58, 0.38), rgba(107, 79, 42, 0.28));
                  border-top-left-radius: 14px;
                  border-top-right-radius: 14px;
                }

                /* Styles pour les badges */
                .badge-gold {
                    background: #fef3c7;
                    color: #92400e;
                    padding: 4px 12px;
                    border-radius: 12px;
                    font-size: 11px;
                    font-weight: bold;
                }
                
                .badge-silver {
                    background: #e5e7eb;
                    color: #374151;
                    padding: 4px 12px;
                    border-radius: 12px;
                    font-size: 11px;
                    font-weight: bold;
                }
                
                .badge-bronze {
                    background: #fed7aa;
                    color: #92400e;
                    padding: 4px 12px;
                    border-radius: 12px;
                    font-size: 11px;
                    font-weight: bold;
                }

                /* Styles pour les cartes de vente */
                .vente-card { 
                    transition: all 0.3s ease; 
                    border: 1px solid #e9ecef; 
                    height: 100%; 
                }
                
                .vente-card:hover { 
                    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important; 
                    transform: translateY(-5px); 
                }
                
                .vente-card .card-header { 
                    background: linear-gradient(135deg, #10b981 0%, #059669 100%); 
                    border-bottom: none; 
                    padding: 16px; 
                }
                
                .vente-card .card-header .badge { 
                    background: rgba(255, 255, 255, 0.3); 
                    color: white; 
                    font-size: 0.9rem; 
                    padding: 6px 12px; 
                }
                
                .vente-card .card-body { 
                    padding: 18px 16px; 
                }
                
                .vente-card .info-row { 
                    display: flex; 
                    align-items: flex-start; 
                    gap: 12px; 
                    margin-bottom: 14px; 
                    font-size: 0.9rem; 
                }
                
                .vente-card .info-row i { 
                    color: #10b981; 
                    min-width: 20px; 
                    margin-top: 2px; 
                    font-size: 1rem; 
                }
                
                .vente-card .info-label { 
                    color: #9ca3af; 
                    font-weight: 500; 
                    font-size: 0.8rem; 
                    text-transform: uppercase; 
                }
                
                .vente-card .info-value { 
                    color: #1a1a2e; 
                    font-weight: 500; 
                }
                
                .vente-card .montant-value { 
                    color: #15803d; 
                    font-weight: 700; 
                    font-size: 1.1rem; 
                }
                
                .vente-card .card-footer { 
                    background: #f9fafb; 
                    border-top: 1px solid #e9ecef; 
                    padding: 12px 16px; 
                    display: flex; 
                    gap: 6px; 
                }
                
                .vente-card .btn-group { 
                    width: 100%; 
                    display: flex; 
                    gap: 6px; 
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {# Bootstrap 5 JS #}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

            {# AssetMapper / Importmap entrypoint (Stimulus, controllers, etc.) #}
            {{ importmap('app') }}
        {% endblock %}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>