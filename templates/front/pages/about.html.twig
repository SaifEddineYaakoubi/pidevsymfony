{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}About - AgriCulture{% endblock %}

{% block agriculteur_body %}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'About',
        breadcrumbs: [
            { label: 'Home', route: 'app_agriculteur_home' },
            { label: 'About' }
        ]
    } %}

    <section id="about-3" class="about-3 section">
        <div class="container">
            <div class="row gy-4 justify-content-between align-items-center">
                <div class="col-lg-6 order-lg-2 position-relative" data-aos="zoom-out">
                    <img src="{{ asset('agriculture/assets/img/img_sq_1.jpg') }}" alt="Image" class="img-fluid">
                    <a href="https://www.youtube.com/watch?v=Y7f98aduVJ8" class="glightbox pulsating-play-btn">
                        <span class="play"><i class="bi bi-play-fill"></i></span>
                    </a>
                </div>
                <div class="col-lg-5 order-lg-1" data-aos="fade-up" data-aos-delay="100">
                    <h2 class="content-title mb-4">Plants Make Life Better</h2>
                    <p class="mb-4">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Enim necessitatibus placeat, atque qui voluptatem velit explicabo.
                    </p>
                    <ul class="list-unstyled list-check">
                        <li>Lorem ipsum dolor sit amet</li>
                        <li>Velit explicabo vitae repellendu</li>
                        <li>Repellat aliquam nihil illo</li>
                    </ul>

                    <p><a href="{{ path('app_agriculteur_contact') }}" class="btn-cta">Get in touch</a></p>
                </div>
            </div>
        </div>
    </section>

    <section class="team-15 team section" id="team">
        <div class="container section-title" data-aos="fade-up">
            <h2>Team</h2>
            <p>Necessitatibus eius consequatur</p>
        </div>

        <div class="content">
            <div class="container">
                <div class="row">
                    {% for i in 1..4 %}
                        <div class="col-lg-3 col-md-6 mb-4">
                            <div class="person">
                                <figure>
                                    <img src="{{ asset('agriculture/assets/img/team/team-' ~ i ~ '.jpg') }}" alt="Image" class="img-fluid">
                                    <div class="social">
                                        <a href="#"><span class="bi bi-facebook"></span></a>
                                        <a href="#"><span class="bi bi-twitter-x"></span></a>
                                        <a href="#"><span class="bi bi-linkedin"></span></a>
                                    </div>
                                </figure>
                                <div class="person-contents">
                                    <h3>Team Member {{ i }}</h3>
                                    <span class="position">Role</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

