{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Blog Details - AgriCulture{% endblock %}

{% block agriculteur_body %}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'Blog Details',
        breadcrumbs: [
            { label: 'Home', route: 'app_agriculteur_home' },
            { label: 'Blog', route: 'app_agriculteur_blog' },
            { label: 'Details' }
        ]
    } %}

    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <section id="blog-details" class="blog-details section">
                    <div class="container">
                        <article class="article">
                            <div class="post-img">
                                <img src="{{ asset('agriculture/assets/img/blog/blog-1.jpg') }}" alt="" class="img-fluid">
                            </div>

                            <h2 class="title">{{ slug|replace({'-':' '})|title }}</h2>

                            <div class="meta-top">
                                <ul>
                                    <li class="d-flex align-items-center"><i class="bi bi-person"></i> <a href="#">John Doe</a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-clock"></i> <a href="#"><time datetime="2026-04-05">Apr 5, 2026</time></a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-chat-dots"></i> <a href="#blog-comments">8 Comments</a></li>
                                </ul>
                            </div>

                            <div class="content">
                                <p>
                                    Similique neque nam consequuntur ad non maxime aliquam quas. Quibusdam animi praesentium. Aliquam et laboriosam eius aut nostrum quidem.
                                </p>

                                <p>
                                    Sit repellat hic cupiditate hic ut nemo. Quis nihil sunt non reiciendis. Sequi in accusamus harum vel aspernatur.
                                </p>

                                <blockquote>
                                    <p>
                                        Et vero doloremque tempore voluptatem ratione vel aut. Deleniti sunt animi aut.
                                    </p>
                                </blockquote>

                                <h3>Et quae iure vel ut odit alias.</h3>
                                <p>
                                    Officiis animi maxime nulla quo et harum eum quis a. Sit hic in qui quos fugit ut rerum atque.
                                </p>

                                <img src="{{ asset('agriculture/assets/img/blog/blog-inside-post.jpg') }}" class="img-fluid" alt="">
                            </div>

                            <div class="meta-bottom">
                                <i class="bi bi-folder"></i>
                                <ul class="cats">
                                    <li><a href="#">Business</a></li>
                                </ul>

                                <i class="bi bi-tags"></i>
                                <ul class="tags">
                                    <li><a href="#">Creative</a></li>
                                    <li><a href="#">Tips</a></li>
                                    <li><a href="#">Marketing</a></li>
                                </ul>
                            </div>
                        </article>

                        <p class="mt-4">
                            <a class="btn btn-outline-primary" href="{{ path('app_agriculteur_blog') }}">Retour au blog</a>
                        </p>
                    </div>
                </section>

                <section id="blog-comments" class="blog-comments section">
                    <div class="container">
                        <h4 class="comments-count">8 Comments</h4>

                        {% set comments = [
                            { img: 'comments-1.jpg', name: 'Georgia Reader', date: '01 Jan, 2022', text: 'Et rerum totam nisi. Molestiae vel quam dolorum vel voluptatem.' },
                            { img: 'comments-2.jpg', name: 'Aron Alvarado', date: '01 Jan, 2022', text: 'Ipsam tempora sequi voluptatem quis sapiente non. Autem itaque eveniet saepe.' },
                            { img: 'comments-5.jpg', name: 'Nolan Davidson', date: '01 Jan, 2022', text: 'Distinctio nesciunt rerum reprehenderit sed. Iste omnis eius repellendus.' }
                        ] %}

                        {% for c in comments %}
                            <div class="comment">
                                <div class="d-flex">
                                    <div class="comment-img"><img src="{{ asset('agriculture/assets/img/blog/' ~ c.img) }}" alt=""></div>
                                    <div>
                                        <h5><a href="#">{{ c.name }}</a> <a href="#" class="reply"><i class="bi bi-reply-fill"></i> Reply</a></h5>
                                        <time datetime="2022-01-01">{{ c.date }}</time>
                                        <p>{{ c.text }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <div class="widgets-container">
                    <div class="search-widget widget-item">
                        <h3 class="widget-title">Search</h3>
                        <form action="#">
                            <input type="text" placeholder="Search...">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>
                    </div>

                    <div class="categories-widget widget-item">
                        <h3 class="widget-title">Categories</h3>
                        <ul class="mt-3">
                            <li><a href="#">General <span>(25)</span></a></li>
                            <li><a href="#">Lifestyle <span>(12)</span></a></li>
                            <li><a href="#">Travel <span>(5)</span></a></li>
                            <li><a href="#">Design <span>(22)</span></a></li>
                            <li><a href="#">Creative <span>(8)</span></a></li>
                            <li><a href="#">Edu <span>(14)</span></a></li>
                        </ul>
                    </div>

                    <div class="recent-posts-widget widget-item">
                        <h3 class="widget-title">Recent Posts</h3>

                        {% for i in 1..3 %}
                            <div class="post-item">
                                <img src="{{ asset('agriculture/assets/img/blog/blog-recent-' ~ i ~ '.jpg') }}" alt="" class="flex-shrink-0">
                                <div>
                                    <h4><a href="{{ path('app_agriculteur_blog_details', {slug: 'recent-post-' ~ i}) }}">Recent post {{ i }}</a></h4>
                                    <time datetime="2022-01-01">Jan 1, 2022</time>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="tags-widget widget-item">
                        <h3 class="widget-title">Tags</h3>
                        <ul>
                            <li><a href="#">App</a></li>
                            <li><a href="#">IT</a></li>
                            <li><a href="#">Business</a></li>
                            <li><a href="#">Mac</a></li>
                            <li><a href="#">Design</a></li>
                            <li><a href="#">Office</a></li>
                            <li><a href="#">Creative</a></li>
                            <li><a href="#">Studio</a></li>
                            <li><a href="#">Smart</a></li>
                            <li><a href="#">Tips</a></li>
                            <li><a href="#">Marketing</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

