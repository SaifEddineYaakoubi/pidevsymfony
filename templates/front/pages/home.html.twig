{% extends 'front/base_agriculteur.html.twig' %}

{% block title %}Smart Farm - Dashboard{% endblock %}

{% block agriculteur_body %}
    <section class="section">
        <div class="container" data-aos="fade-up">
            <div class="row align-items-center mb-4">
                <div class="col-lg-8">
                    <h2 class="mb-1">Tableau de bord</h2>
                    <p class="text-muted mb-0">
                        Résumé global des modules : parcelles, cultures, ventes, clients, récoltes et rendements.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <span class="badge bg-success">Mise à jour : {{ "now"|date("d/m/Y H:i") }}</span>
                </div>
            </div>

            {% set cards = [
                {
                    title: 'Parcelles',
                    count: counts.parcelles ?? 0,
                    icon: 'bi-map',
                    route: path('agri_parcelle_index'),
                    color: 'success'
                },
                {
                    title: 'Cultures',
                    count: counts.cultures ?? 0,
                    icon: 'bi-flower1',
                    route: path('agri_culture_index'),
                    color: 'success'
                },
                {
                    title: 'Ventes',
                    count: counts.ventes ?? 0,
                    icon: 'bi-receipt',
                    route: path('app_vente_index'),
                    color: 'primary'
                },
                {
                    title: 'Clients',
                    count: counts.clients ?? 0,
                    icon: 'bi-people',
                    route: path('app_client_index'),
                    color: 'primary'
                },
                {
                    title: 'Récoltes',
                    count: counts.recoltes ?? 0,
                    icon: 'bi-basket',
                    route: path('app_recolte_index'),
                    color: 'warning'
                },
                {
                    title: 'Rendements',
                    count: counts.rendements ?? 0,
                    icon: 'bi-graph-up-arrow',
                    route: path('app_rendement_index'),
                    color: 'warning'
                }
            ] %}

            <div class="row g-4">
                {% for c in cards %}
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="text-muted small mb-1">Module</div>
                                    <h5 class="mb-2">{{ c.title }}</h5>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-{{ c.color }}">Total : {{ c.count }}</span>
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ c.route }}">Ouvrir</a>
                                    </div>
                                </div>
                                <div class="ms-3">
                                    <span class="badge bg-light text-dark p-3">
                                        <i class="bi {{ c.icon }}" style="font-size: 1.4rem;"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {# Weather card removed as requested #}
            </div>

            <div class="row mt-5">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="mb-2">Accès rapide</h5>
                            <p class="text-muted mb-3">Aller directement vers les listes et gérer les données.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-success" href="{{ path('agri_parcelle_index') }}">Gérer Parcelles</a>
                                <a class="btn btn-success" href="{{ path('agri_culture_index') }}">Gérer Cultures</a>
                                <a class="btn btn-outline-primary" href="{{ path('app_vente_index') }}">Gérer Ventes</a>
                                <a class="btn btn-outline-primary" href="{{ path('app_client_index') }}">Gérer Clients</a>
                                <a class="btn btn-outline-warning" href="{{ path('app_recolte_index') }}">Gérer Récoltes</a>
                                <a class="btn btn-outline-warning" href="{{ path('app_rendement_index') }}">Gérer Rendements</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
