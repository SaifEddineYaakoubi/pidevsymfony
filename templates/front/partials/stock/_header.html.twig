<header id="header" class="header d-flex align-items-center position-relative">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

        <a href="http://127.0.0.1:8000/stock" class="logo d-flex align-items-center me-4">
            <img src="{{ asset('agriculture/assets/img/logo.png') }}" alt="AgriCulture">

        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="{{ path('app_stock_home') }}" class="{{ app.request.attributes.get('_route') == 'app_stock_home' ? 'active' : '' }}">Home</a></li>
                {# Stock / Produit (CRUD) #}
                <li><a href="{{ path('stock_index') }}" class="{{ app.request.attributes.get('_route') in ['stock_index', 'stock_show', 'stock_edit', 'stock_new', 'stock_delete'] ? 'active' : '' }}">Stock</a></li>
                <li><a href="{{ path('produit_index') }}" class="{{ app.request.attributes.get('_route') in ['produit_index', 'produit_show', 'produit_edit', 'produit_new', 'produit_delete'] ? 'active' : '' }}">Produit</a></li>

                {# Fonctionnalités Agriculteur (désactivées pour ROLE_STOCK) #}
                <li><a href="#" class="disabled" title="Accès non disponible">Parcelles</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Cultures</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Recoltes</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Rendements</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Archives</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Ventes</a></li>
                <li><a href="#" class="disabled" title="Accès non disponible">Clients</a></li>

                {# Compte Responsable Stock #}
                {% if is_granted('ROLE_STOCK') %}
                    <li class="dropdown">
                        <a href="#">
                            <span>Mon compte</span>
                            <i class="bi bi-chevron-down toggle-dropdown"></i>
                        </a>
                        <ul>
                            <li>
                                <a href="{{ path('app_stock_home') }}">
                                    <i class="bi bi-house-door me-1"></i> Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

    </div>
</header>

