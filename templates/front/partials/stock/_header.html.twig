<header id="header" class="header d-flex align-items-center position-relative">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

        <a href="http://127.0.0.1:8000/stock" class="logo d-flex align-items-center me-4">
            <img src="{{ asset('agriculture/assets/img/logo.png') }}" alt="AgriCulture">
            
        </a>

        

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="{{ path('app_stock_home') }}" class="{{ app.request.attributes.get('_route') == 'app_stock_home' ? 'active' : '' }}">Home</a></li>
                <li>
                    <a href="{{ path('app_messages_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_messages' ? 'active' : '' }}">
                        Messages
                        {% set unreadCount = render(path('app_messages_unread_count'))|trim %}
                        {% if unreadCount > 0 %}
                            <span class="badge bg-danger ms-1" style="font-size: 0.6rem; vertical-align: top;">{{ unreadCount }}</span>
                        {% endif %}
                    </a>
                </li>
                <li><a class="text-danger" href="{{ path('app_logout') }}">Logout</a></li>
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

    </div>
</header>

