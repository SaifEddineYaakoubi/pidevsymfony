<header id="header" class="header d-flex align-items-center position-relative">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

        <a href="http://127.0.0.1:8000/stock" class="logo d-flex align-items-center me-4">
            <img src="{{ asset('agriculture/assets/img/logo.png') }}" alt="AgriCulture">
            
        </a>

        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="{{ path('app_agriculteur_home') }}" class="{{ app.request.attributes.get('_route') == 'app_agriculteur_home' ? 'active' : '' }}">Home</a></li>
                {# Parcelles / Cultures (CRUD) #}
                <li><a href="{{ path('agri_parcelle_index') }}" class="{{ app.request.attributes.get('_route') starts with 'agri_parcelle_' ? 'active' : '' }}">Parcelles</a></li>
                <li><a href="{{ path('agri_culture_index') }}" class="{{ app.request.attributes.get('_route') starts with 'agri_culture_' ? 'active' : '' }}">Cultures</a></li>
                
                {# IA Prédictions #}
                <li><a href="{{ path('agri_ia_index') }}" class="{{ app.request.attributes.get('_route') starts with 'agri_ia_' ? 'active' : '' }}">Stratégie de cultures</a></li>

                {# Recoltes / Rendements / Archives (CRUD) #}
                <li><a href="{{ path('app_recolte_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_recolte_' ? 'active' : '' }}">Recoltes</a></li>
                <li><a href="{{ path('app_rendement_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_rendement_' ? 'active' : '' }}">Rendements</a></li>
                <li><a href="{{ path('app_archive_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_archive_' ? 'active' : '' }}">Archives</a></li>

                {# Vente / Client (CRUD) #}
                <li><a href="{{ path('app_vente_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_vente_' ? 'active' : '' }}">Ventes</a></li>
                <li><a href="{{ path('app_client_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_client_' ? 'active' : '' }}">Clients</a></li>

                {# Compte Agriculteur #}
                {% if is_granted('ROLE_AGRICULTEUR') %}
                    <li class="dropdown">
                        <a href="#">
                            <span>Mon compte</span>
                            <i class="bi bi-chevron-down toggle-dropdown"></i>
                        </a>
                        <ul>
                            <li>
                                <a href="{{ path('app_agriculteur_profile') }}">
                                    <i class="bi bi-person me-1"></i> Profil
                                </a>
                            </li>
                            <li>
                                <a class="text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>

    </div>
</header>
