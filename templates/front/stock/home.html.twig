{% extends 'front/base_stock.html.twig' %}

{% block title %}Responsable Stock - Accueil{% endblock %}

{% block agriculteur_body %}
    {# Reuse the same page title partial if needed #}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'Espace Stock',
        breadcrumbs: [
            { label: 'Home', route: 'app_stock_home' }
        ]
    } %}

    <div class="container section py-0">
        <div class="row g-4">
            <div class="col-lg-12">
                <div class="card mb-4 shadow-sm rounded-4 border-0">
                    <div class="card-body">
                        <h2>Statistiques</h2>
                        <p class="text-muted mb-4">
                            Ici, tu affiches les informations spécifiques au responsable de stock (stocks, alertes, mouvements, etc.).
                        </p>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card" style="border-left: 5px solid #2E8B57;">
                                    <div class="card-body">
                                        <h5 class="card-title" style="color: #2E8B57;">Total Produits</h5>
                                        <p class="card-text display-4" style="color: #2E8B57;">{{ stats.totalProduits }}</p>
                                        <p class="text-muted">📈 Tendance à la hausse</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card" style="border-left: 5px solid #2E8B57;">
                                    <div class="card-body">
                                        <h5 class="card-title" style="color: #2E8B57;">Total Entrées Stock</h5>
                                        <p class="card-text display-4" style="color: #2E8B57;">{{ stats.totalStocks }}</p>
                                        <p class="text-muted">📊 Fluctuation légère</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card" style="border-left: 5px solid #556B2F;">
                                    <div class="card-body">
                                        <h5 class="card-title" style="color: #556B2F;">Quantité Totale en Stock</h5>
                                        <p class="card-text display-4" style="color: #556B2F;">{{ stats.totalQuantity }}</p>
                                        <p class="text-muted">🔎 Vérifiez les produits critiques.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card" style="border-left: 5px solid #FFA500;">
                                    <div class="card-body">
                                        <h5 class="card-title" style="color: #FFA500;">Prix Moyen des Produits</h5>
                                        <p class="card-text display-4" style="color: #FFA500;">{{ stats.averagePrice }} DT</p>
                                        <p class="text-muted">➡️ Tendance stable</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm rounded-4 border-0">
                    <div class="card-body">
                        <h5 class="card-title">Répartition des Produits par Type</h5>
                        <canvas id="productTypesChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="/adminlte/plugins/chart.js/Chart.min.js"></script>
    <script>
    (function() {
        const chartEl = document.getElementById('productTypesChart');
        if (!chartEl || typeof Chart === 'undefined') {
            return;
        }

        const ctx = chartEl.getContext('2d');
        const productTypes = {{ productTypes|json_encode|raw }};

        function getEmoji(type) {
            const emojiMap = {
                'légume': '🥔',
                'fruit': '🍓',
                'huile': '🛢️',
                'céréale': '🌾',
                'herbe aromatique': '🌿',
                'racine/tubercule': '🥕',
                'autres': '❓'
            };
            return emojiMap[type.toLowerCase()] || '❓';
        }

        const labels = productTypes.map(item => `${getEmoji(item.type)} ${item.type}`);
        const data = productTypes.map(item => parseInt(item.count, 10));

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Nombre de Produits',
                    data: data,
                    backgroundColor: [
                        'rgba(46, 139, 87, 0.8)',
                        'rgba(85, 107, 47, 0.8)',
                        'rgba(139, 69, 19, 0.8)',
                        'rgba(233, 150, 122, 0.8)',
                        'rgba(255, 215, 0, 0.8)',
                        'rgba(70, 130, 180, 0.8)',
                        'rgba(128, 128, 128, 0.8)'
                    ],
                    borderColor: [
                        'rgba(46, 139, 87, 1)',
                        'rgba(85, 107, 47, 1)',
                        'rgba(139, 69, 19, 1)',
                        'rgba(233, 150, 122, 1)',
                        'rgba(255, 215, 0, 1)',
                        'rgba(70, 130, 180, 1)',
                        'rgba(128, 128, 128, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Répartition des Produits par Type'
                    }
                }
            }
        });
    })();
    </script>
{% endblock %}

