{% extends 'front/base_stock.html.twig' %}

{% block title %}Responsable Stock - Accueil{% endblock %}

{% block agriculteur_body %}
    {# Reuse the same page title partial if needed #}
    {% include 'front/partials/_page_title.html.twig' with {
        title: 'Espace Stock',
        breadcrumbs: [
            { label: 'Home', route: 'app_stock_home' }
        ]
    } %}

    <div class="container section py-5">
        <div class="row">
            <div class="col-lg-8">
                <h2>Dashboard Stock</h2>
                <p class="text-muted mb-4">
                    Ici, tu affiches les informations spécifiques au responsable de stock (stocks, alertes, mouvements, etc.).
                </p>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Stocks faibles</h5>
                                <p class="card-text">À brancher sur tes données.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Entrées / Sorties</h5>
                                <p class="card-text">À brancher sur tes données.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Raccourcis</h5>
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-primary" href="#">Voir Stock</a>
                            <a class="btn btn-outline-primary" href="#">Mouvements</a>
                            <a class="btn btn-outline-primary" href="#">Alertes</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

