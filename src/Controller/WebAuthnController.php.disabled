<?php

namespace App\Controller;

use App\Entity\Utilisateur;
use App\Repository\PublicKeyCredentialSourceRepository;
use Doctrine\ORM\EntityManagerInterface;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Annotation\Route;
use Symfony\Component\Security\Http\Attribute\CurrentUser;
use Webauthn\PublicKeyCredentialCreationOptions;
use Webauthn\PublicKeyCredentialRequestOptions;
use Webauthn\PublicKeyCredentialRpEntity;
use Webauthn\PublicKeyCredentialParameters;
use Webauthn\PublicKeyCredentialDescriptor;
use Webauthn\AuthenticatorSelectionCriteria;
use Webauthn\Bundle\Service\PublicKeyCredentialCreationOptionsFactory;
use Webauthn\Bundle\Service\PublicKeyCredentialRequestOptionsFactory;
use Cose\Algorithm\Signature\ECDSA\ES256;
use Cose\Algorithm\Signature\RSA\RS256;

#[Route('/webauthn')]
class WebAuthnController extends AbstractController
{
    public function __construct(
        private EntityManagerInterface $entityManager,
        private PublicKeyCredentialSourceRepository $credentialRepository
    ) {}

    #[Route('/register/options', name: 'webauthn_register_options', methods: ['POST'])]
    public function registerOptions(#[CurrentUser] ?Utilisateur $user): JsonResponse
    {
        if (!$user) {
            return new JsonResponse(['error' => 'User not authenticated'], 401);
        }

        // Créer l'entité utilisateur WebAuthn
        $userEntity = $user->getPublicKeyCredentialUserEntity();
        
        // Sauvegarder le userHandle si nécessaire
        if ($user->getWebauthnUserHandle() === null) {
            $this->entityManager->flush();
        }

        // Créer les options de création
        $rpEntity = new PublicKeyCredentialRpEntity(
            'AgriPlatform',
            'localhost',
            null
        );

        $publicKeyCredentialParametersList = [
            new PublicKeyCredentialParameters('public-key', ES256::identifier()),
            new PublicKeyCredentialParameters('public-key', RS256::identifier()),
        ];

        $challenge = random_bytes(32);
        
        // Récupérer les credentials existants pour les exclure
        $excludeCredentials = [];
        $existingCredentials = $this->credentialRepository->findAllForUserEntity($userEntity);
        foreach ($existingCredentials as $credential) {
            $excludeCredentials[] = new PublicKeyCredentialDescriptor(
                'public-key',
                $credential->getPublicKeyCredentialId()
            );
        }

        $authenticatorSelection = new AuthenticatorSelectionCriteria(
            'platform',
            true,
            'required'
        );

        $publicKeyCredentialCreationOptions = new PublicKeyCredentialCreationOptions(
            $rpEntity,
            $userEntity,
            $challenge,
            $publicKeyCredentialParametersList,
            60000,
            $excludeCredentials,
            $authenticatorSelection,
            'none',
            null
        );

        // Stocker le challenge en session
        $this->get('session')->set('webauthn_registration_challenge', base64_encode($challenge));

        return new JsonResponse($publicKeyCredentialCreationOptions);
    }

    #[Route('/register/verify', name: 'webauthn_register_verify', methods: ['POST'])]
    public function registerVerify(Request $request, #[CurrentUser] ?Utilisateur $user): JsonResponse
    {
        if (!$user) {
            return new JsonResponse(['error' => 'User not authenticated'], 401);
        }

        try {
            $data = json_decode($request->getContent(), true);
            
            // Ici, vous devriez valider la réponse avec la librairie WebAuthn
            // Pour simplifier, nous allons juste retourner un succès
            // Dans une vraie implémentation, utilisez le PublicKeyCredentialLoader et l'AuthenticatorAttestationResponseValidator
            
            return new JsonResponse([
                'success' => true,
                'message' => 'Face ID configuré avec succès'
            ]);
        } catch (\Exception $e) {
            return new JsonResponse([
                'error' => 'Erreur lors de la configuration: ' . $e->getMessage()
            ], 400);
        }
    }

    #[Route('/login/options', name: 'webauthn_login_options', methods: ['POST'])]
    public function loginOptions(Request $request): JsonResponse
    {
        try {
            $data = json_decode($request->getContent(), true);
            $email = $data['email'] ?? null;

            if (!$email) {
                return new JsonResponse(['error' => 'Email requis'], 400);
            }

            $user = $this->entityManager->getRepository(Utilisateur::class)->findOneBy(['email' => $email]);
            
            if (!$user) {
                return new JsonResponse(['error' => 'Utilisateur non trouvé'], 404);
            }

            $userEntity = $user->getPublicKeyCredentialUserEntity();
            $credentials = $this->credentialRepository->findAllForUserEntity($userEntity);

            if (empty($credentials)) {
                return new JsonResponse(['error' => 'Aucun Face ID configuré pour cet utilisateur'], 404);
            }

            $allowCredentials = [];
            foreach ($credentials as $credential) {
                $allowCredentials[] = new PublicKeyCredentialDescriptor(
                    'public-key',
                    $credential->getPublicKeyCredentialId(),
                    $credential->getTransports()
                );
            }

            $challenge = random_bytes(32);

            $publicKeyCredentialRequestOptions = new PublicKeyCredentialRequestOptions(
                $challenge,
                60000,
                'localhost',
                $allowCredentials,
                'required',
                null
            );

            // Stocker le challenge et l'email en session
            $session = $request->getSession();
            $session->set('webauthn_login_challenge', base64_encode($challenge));
            $session->set('webauthn_login_email', $email);

            return new JsonResponse($publicKeyCredentialRequestOptions);
        } catch (\Exception $e) {
            return new JsonResponse(['error' => $e->getMessage()], 500);
        }
    }

    #[Route('/login/verify', name: 'webauthn_login_verify', methods: ['POST'])]
    public function loginVerify(Request $request): JsonResponse
    {
        try {
            $session = $request->getSession();
            $email = $session->get('webauthn_login_email');

            if (!$email) {
                return new JsonResponse(['error' => 'Session expirée'], 401);
            }

            $user = $this->entityManager->getRepository(Utilisateur::class)->findOneBy(['email' => $email]);
            
            if (!$user) {
                return new JsonResponse(['error' => 'Utilisateur non trouvé'], 404);
            }

            // Ici, vous devriez valider la réponse avec la librairie WebAuthn
            // Pour simplifier, nous retournons un succès
            // Dans une vraie implémentation, utilisez le PublicKeyCredentialLoader et l'AuthenticatorAssertionResponseValidator

            // Nettoyer la session
            $session->remove('webauthn_login_challenge');
            $session->remove('webauthn_login_email');

            return new JsonResponse([
                'success' => true,
                'redirect' => $this->generateUrl('app_admin_dashboard')
            ]);
        } catch (\Exception $e) {
            return new JsonResponse(['error' => $e->getMessage()], 500);
        }
    }
}
